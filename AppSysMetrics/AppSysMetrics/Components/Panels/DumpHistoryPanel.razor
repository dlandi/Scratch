@inject DumpDiffService DiffService

<div class="panel">
    <h5 class="panel-heading">Dump History</h5>
    @if (History is not null && History.Count > 0)
    {
        <div class="dump-history-list">
            <table class="gen-table">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>File</th>
                        <th>Captured</th>
                        <th>Heap</th>
                        <th>Objects</th>
                        <th>File Size</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in History.Reverse())
                    {
                        var isSelected = item == _selectedFirst || item == _selectedSecond;
                        var tag = GetTag(item);
                        <tr class="@(isSelected ? "dump-selected" : "")"
                            @onclick="() => HandleSelect(item)">
                            <td>
                                @if (tag == "BASE")
                                {
                                    <span class="dump-tag dump-tag-baseline">BASE</span>
                                }
                                else if (tag == "CUR")
                                {
                                    <span class="dump-tag dump-tag-current">CUR</span>
                                }
                            </td>
                            <td class="type-name">@item.FileName</td>
                            <td>@item.CapturedAtUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                            <td>@FormatBytes(item.TotalHeapBytes)</td>
                            <td>@item.TotalObjectCount.ToString("N0")</td>
                            <td>@FormatBytes(item.FileSizeBytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dump-actions">
            @if (_selectedFirst is not null && _selectedSecond is not null)
            {
                <button class="btn btn-info" @onclick="HandleCompare">
                    Compare Selected
                </button>
            }
            else
            {
                <span class="dump-compare-hint">
                    Click two dumps to select baseline and current for comparison.
                </span>
            }

            <button class="btn btn-danger" @onclick="HandleClearAll">
                Clear All
            </button>

            @if (_clearMessage is not null)
            {
                <span class="dump-clear-message">@_clearMessage</span>
            }
        </div>
    }
    else
    {
        <div class="panel-loading">No analyzed dumps yet.</div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<DumpAnalysisResult>? History { get; set; }
    [Parameter] public EventCallback<DumpDiffResult> OnCompare { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    private DumpAnalysisResult? _selectedFirst;
    private DumpAnalysisResult? _selectedSecond;
    private string? _clearMessage;

    private void HandleSelect(DumpAnalysisResult item)
    {
        if (_selectedFirst is null)
        {
            _selectedFirst = item;
        }
        else if (_selectedSecond is null && item != _selectedFirst)
        {
            _selectedSecond = item;
        }
        else
        {
            // Reset: start new selection
            _selectedFirst = item;
            _selectedSecond = null;
        }
    }

    /// <summary>
    /// Returns "BASE" for the older dump, "CUR" for the newer dump,
    /// or null if the item is not selected. Tags are based on chronological
    /// order (CapturedAtUtc), not click order.
    /// </summary>
    private string? GetTag(DumpAnalysisResult item)
    {
        if (_selectedFirst is null) return null;

        // Only one selected — it's shown as BASE (waiting for second pick)
        if (_selectedSecond is null)
            return item == _selectedFirst ? "BASE" : null;

        // Two selected — derive baseline/current from timestamps
        var (baseline, current) = _selectedFirst.CapturedAtUtc <= _selectedSecond.CapturedAtUtc
            ? (_selectedFirst, _selectedSecond)
            : (_selectedSecond, _selectedFirst);

        if (item == baseline) return "BASE";
        if (item == current) return "CUR";
        return null;
    }

    private async Task HandleCompare()
    {
        if (_selectedFirst is null || _selectedSecond is null) return;

        // Ensure baseline is the older dump
        var (baseline, current) = _selectedFirst.CapturedAtUtc <= _selectedSecond.CapturedAtUtc
            ? (_selectedFirst, _selectedSecond)
            : (_selectedSecond, _selectedFirst);

        var diff = DiffService.ComputeDiff(baseline, current);
        await OnCompare.InvokeAsync(diff);
    }

    private async Task HandleClearAll()
    {
        if (History is null || History.Count == 0) return;

        var deleted = 0;
        foreach (var item in History)
        {
            try
            {
                if (File.Exists(item.FilePath))
                {
                    File.Delete(item.FilePath);
                    deleted++;
                }
            }
            catch (IOException)
            {
                // File may be locked — skip it
            }
        }

        _selectedFirst = null;
        _selectedSecond = null;
        _clearMessage = $"Deleted {deleted} dump file{(deleted == 1 ? "" : "s")} from disk.";

        await OnClear.InvokeAsync();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1_024) return $"{bytes / 1_024.0:F1} KB";
        return $"{bytes} B";
    }
}
