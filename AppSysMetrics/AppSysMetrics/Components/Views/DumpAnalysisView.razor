@implements IDisposable
@inject DumpAnalysisHub AnalysisHub
@inject MetricsHub MetricsHub

<div class="asm-dashboard">
    <div class="asm-dashboard-header">
        <h1>Dump Analysis</h1>
        <p class="asm-subtitle">
            GC dump file monitoring, heap analysis, and memory leak detection via diff comparison.
            @if (_latestAnalysis is not null)
            {
                <span class="asm-last-updated">
                    Last analysis: @_latestAnalysis.AnalyzedAtUtc.ToLocalTime().ToString("HH:mm:ss")
                </span>
            }
        </p>
    </div>

    <div class="asm-grid asm-grid-dump">
        <div class="asm-cell asm-cell-full">
            <MemoryHealthPanel Snapshot="_latestMetrics" History="_metricsHistory" />
        </div>
        <div class="asm-cell asm-cell-full">
            <DumpHistoryPanel History="_history" OnCompare="HandleManualCompare" OnClear="HandleClear" />
        </div>
        <div class="asm-cell">
            <DumpAnalysisPanel Result="_latestAnalysis" />
        </div>
        <div class="asm-cell">
            <DumpDiffPanel Diff="_activeDiff" />
        </div>
        <div class="asm-cell asm-cell-full">
            <GcRootAnalysisPanel RootAnalysis="_rootAnalysis" LeakSuspects="_confirmedLeakSuspects" />
        </div>
    </div>
</div>

@code {
    private DumpAnalysisResult? _latestAnalysis;
    private DumpDiffResult? _activeDiff;
    private List<DumpAnalysisResult> _history = [];
    private MetricsSnapshot? _latestMetrics;
    private IReadOnlyList<MetricsSnapshot> _metricsHistory = [];

    // Phase 6: Root analysis for confirmed leak suspects
    private RootAnalysisResult? _rootAnalysis;
    private IReadOnlyList<HeapTypeDiff>? _confirmedLeakSuspects;

    protected override void OnInitialized()
    {
        _latestAnalysis = AnalysisHub.Latest;
        _activeDiff = AnalysisHub.LatestDiff;
        _history = AnalysisHub.GetHistory().ToList();
        _latestMetrics = MetricsHub.Latest;
        _metricsHistory = MetricsHub.GetHistory();
        UpdateRootAnalysisState();
        AnalysisHub.OnAnalysis += HandleAnalysis;
        AnalysisHub.OnDiff += HandleDiff;
        AnalysisHub.OnCleared += HandleCleared;
        MetricsHub.OnSnapshot += HandleMetricsSnapshot;
    }

    private async void HandleAnalysis(DumpAnalysisResult result)
    {
        _latestAnalysis = result;
        _history = AnalysisHub.GetHistory().ToList();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async void HandleDiff(DumpDiffResult diff)
    {
        _activeDiff = diff;
        UpdateRootAnalysisState();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private void HandleManualCompare(DumpDiffResult diff)
    {
        _activeDiff = diff;
        UpdateRootAnalysisState();
        StateHasChanged();
    }

    private void HandleClear()
    {
        AnalysisHub.Clear();
        _latestAnalysis = null;
        _activeDiff = null;
        _history = [];
        _rootAnalysis = null;
        _confirmedLeakSuspects = null;
    }

    private async void HandleCleared()
    {
        _latestAnalysis = null;
        _activeDiff = null;
        _history = [];
        _rootAnalysis = null;
        _confirmedLeakSuspects = null;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async void HandleMetricsSnapshot(MetricsSnapshot snapshot)
    {
        _latestMetrics = snapshot;
        _metricsHistory = MetricsHub.GetHistory();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private void UpdateRootAnalysisState()
    {
        _rootAnalysis = _activeDiff?.Current.RootAnalysis;
        _confirmedLeakSuspects = _activeDiff is { HasAllocationCorrelation: true }
            ? _activeDiff.TypeDiffs
                .Where(t => t.RetentionRatio >= 0.8 && t.AllocatedBetweenBytes is > 0)
                .OrderByDescending(t => t.RetentionRatio)
                .ThenByDescending(t => t.DeltaSizeBytes)
                .ToList()
            : null;
    }

    public void Dispose()
    {
        AnalysisHub.OnAnalysis -= HandleAnalysis;
        AnalysisHub.OnDiff -= HandleDiff;
        AnalysisHub.OnCleared -= HandleCleared;
        MetricsHub.OnSnapshot -= HandleMetricsSnapshot;
    }
}
