@implements IDisposable
@inject MetricsHub MetricsHub

<div class="asm-dashboard">
    <div class="asm-dashboard-header">
        <h1>System Metrics Dashboard</h1>
        <p class="asm-subtitle">
            Real-time process, CPU, and GC metrics updated every 2 seconds.
            @if (_latest is not null)
            {
                <span class="asm-last-updated">Last update: @_latest.CapturedAt.ToLocalTime().ToString("HH:mm:ss")</span>
            }
        </p>
    </div>

    <div class="asm-grid">
        <div class="asm-cell asm-cell-full">
            <MemoryHealthPanel Snapshot="_latest" History="_history" />
        </div>
        <div class="asm-cell">
            <ProcessMetricsPanel Snapshot="_latest" />
        </div>
        <div class="asm-cell">
            <CpuMetricsPanel History="_history" />
        </div>
        <div class="asm-cell">
            <GcMetricsPanel Snapshot="_latest" />
        </div>
        <div class="asm-cell">
            <AllocationRatePanel History="_history" />
        </div>
        @if (AdditionalContent is not null)
        {
            <div class="asm-cell asm-cell-full">
                @AdditionalContent
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? AdditionalContent { get; set; }

    private MetricsSnapshot? _latest;
    private IReadOnlyList<MetricsSnapshot> _history = [];

    protected override void OnInitialized()
    {
        _history = MetricsHub.GetHistory();
        _latest = MetricsHub.Latest;
        MetricsHub.OnSnapshot += HandleSnapshot;
    }

    private async void HandleSnapshot(MetricsSnapshot snapshot)
    {
        _latest = snapshot;
        _history = MetricsHub.GetHistory();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Circuit disconnected
        }
    }

    public void Dispose()
    {
        MetricsHub.OnSnapshot -= HandleSnapshot;
    }
}
