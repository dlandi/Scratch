@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject TimeProvider Time
@inject UserTimeProvider TzPref
@inject ResourceScheduler.Components.Services.BackendSwitcher Backend
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@implements IDisposable

<div class="rs-app">
    <Header ActiveScreen="@CurrentScreen"
            ScreenChanged="OnScreenChanged"
            StoreLabel="@StoreLabelFor(Backend.Mode)"
            CanSwitchBackend="@BackendSwitcherEnabled"
            BackendOptions="@BackendOptions"
            CurrentBackendId="@Backend.Mode.ToString()"
            BackendTitle="@BackendTitleFor(Backend.Mode)"
            BackendChanged="OnBackendChanged"
            TimeZoneLabel="@TzLabel"
            TimeZoneTitle="@TzTitle"
            CanSwitchTimeZone="@TzSwitcherEnabled"
            TimeZoneOptions="@TimeZoneOptions"
            CurrentTimeZoneId="@Time.LocalTimeZone.Id"
            TimeZoneChanged="OnTimeZoneChanged" />
    <div class="rs-main">
        @Body
    </div>
</div>

@code {
    /// <summary>
    /// Mirrors the screen ids the <c>Header</c> emits. The host maps each
    /// id to a route so the back/forward buttons keep working.
    /// </summary>
    private string CurrentScreen
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
            return path switch
            {
                "/buildings"   => "buildings",
                "/devices"     => "devices",
                "/groups"      => "groups",
                "/designer"    => "designer",
                "/tests"       => "tests",
                "/schedule"    => "schedule",
                "/reservation" => "reservation",
                _              => "dashboard",
            };
        }
    }

    /// <summary>
    /// Short UTC-offset label for the effective timezone, e.g.
    /// "UTC-04:00". Recomputed each render so it updates on dropdown
    /// change and on DST transitions.
    /// </summary>
    private string TzLabel
    {
        get
        {
            var offset = Time.GetLocalNow().Offset;
            var sign = offset >= TimeSpan.Zero ? "+" : "-";
            var abs = offset.Duration();
            return $"UTC{sign}{abs:hh\\:mm}";
        }
    }

    /// <summary>Hover tooltip with the full IANA / Windows zone display name.</summary>
    private string TzTitle => Time.LocalTimeZone.DisplayName;

    /// <summary>
    /// Controls whether the header timezone label is rendered as a static
    /// chip or an interactive dropdown. Driven by the
    /// <c>Features:TimeZoneSwitcher:Enabled</c> appsettings flag.
    /// </summary>
    private bool TzSwitcherEnabled =>
        Config.GetValue<bool>("Features:TimeZoneSwitcher:Enabled");

    /// <summary>
    /// One entry per integer-hour UTC offset, plus the host's own zone
    /// when it has a fractional offset (e.g. India UTC+05:30). Each
    /// integer-hour bucket is represented by its alphabetically-first
    /// system zone so DST behaviour still applies when the user picks
    /// it. The full system catalog (around 313 entries) was too noisy
    /// for a developer testing aid.
    /// </summary>
    private static readonly IReadOnlyList<TimeZoneInfo> TimeZoneOptions = BuildTimeZoneOptions();

    private static IReadOnlyList<TimeZoneInfo> BuildTimeZoneOptions()
    {
        // Prefer popular IANA regions over Antarctica and Etc/* aliases
        // when picking a representative for each offset bucket. This
        // gives "UTC+05:00 · Asia/Karachi" instead of
        // "UTC+05:00 · Antarctica/Mawson".
        static int RegionRank(string id)
        {
            if (id.StartsWith("Antarctica/", StringComparison.Ordinal)) return 9;
            if (id.StartsWith("Etc/",         StringComparison.Ordinal)) return 8;
            return 0;
        }

        var perHour = TimeZoneInfo.GetSystemTimeZones()
            .Where(t => t.BaseUtcOffset.Minutes == 0 && t.BaseUtcOffset.Seconds == 0)
            .GroupBy(t => t.BaseUtcOffset)
            .Select(g => g
                .OrderBy(t => RegionRank(t.Id))
                .ThenBy(t => t.Id, StringComparer.Ordinal)
                .First())
            .ToList();

        // Make sure the host's zone is selectable even when its offset is
        // fractional (UTC+05:30 etc.); without this the dropdown would
        // show no option matching the initial CurrentTimeZoneId.
        var host = TimeZoneInfo.Local;
        if (!perHour.Any(t => string.Equals(t.Id, host.Id, StringComparison.Ordinal)))
        {
            perHour.Add(host);
        }

        return perHour
            .OrderBy(t => t.BaseUtcOffset)
            .ThenBy(t => t.Id, StringComparer.Ordinal)
            .ToList();
    }

    /// <summary>Whether the header backend chip is rendered as an
    /// interactive dropdown. Driven by
    /// <c>Features:BackendSwitcher:Enabled</c>.</summary>
    private bool BackendSwitcherEnabled =>
        Config.GetValue<bool>("Features:BackendSwitcher:Enabled");

    /// <summary>Static option list for the header backend dropdown.</summary>
    private static readonly IReadOnlyList<ResourceScheduler.Components.Services.BackendOption> BackendOptions =
        new[]
        {
            new ResourceScheduler.Components.Services.BackendOption(
                ResourceScheduler.Components.Services.BackendMode.InMemory.ToString(),
                "in-memory store"),
            new ResourceScheduler.Components.Services.BackendOption(
                ResourceScheduler.Components.Services.BackendMode.Rust.ToString(),
                "rust api"),
        };

    private const string BackendStorageKey = "rs:backend";

    private static string StoreLabelFor(ResourceScheduler.Components.Services.BackendMode mode) =>
        mode switch
        {
            ResourceScheduler.Components.Services.BackendMode.Rust => "rust api",
            _ => "in-memory store",
        };

    private static string BackendTitleFor(ResourceScheduler.Components.Services.BackendMode mode) =>
        mode switch
        {
            ResourceScheduler.Components.Services.BackendMode.Rust =>
                "Backend: Rust HTTP API. Switching does not migrate data.",
            _ => "Backend: in-process simulator with seeded fixture data. Switching does not migrate data.",
        };

    protected override void OnInitialized()
    {
        TzPref.Changed += OnZoneChanged;
        Backend.Changed += OnBackendStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!BackendSwitcherEnabled) return;

        // Read the persisted choice once after first render. JS interop
        // requires the WASM runtime to be up, so this can only run on
        // OnAfterRenderAsync, not OnInitialized.
        string? stored = null;
        try
        {
            stored = await JS.InvokeAsync<string?>("localStorage.getItem", BackendStorageKey);
        }
        catch
        {
            // localStorage unavailable (private mode, host quirks, etc.) -- keep default.
        }

        if (Enum.TryParse<ResourceScheduler.Components.Services.BackendMode>(stored, out var mode)
            && mode != Backend.Mode)
        {
            Backend.SetMode(mode);
        }
    }

    private void OnZoneChanged() => InvokeAsync(StateHasChanged);

    private void OnBackendStateChanged() => InvokeAsync(StateHasChanged);

    private void OnTimeZoneChanged(string id) => TzPref.SetTimeZoneById(id);

    private async Task OnBackendChanged(string id)
    {
        if (!Enum.TryParse<ResourceScheduler.Components.Services.BackendMode>(id, out var mode))
        {
            return;
        }
        Backend.SetMode(mode);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", BackendStorageKey, mode.ToString());
        }
        catch
        {
            // Persistence is best-effort; the in-session switch still applies.
        }
    }

    public void Dispose()
    {
        TzPref.Changed -= OnZoneChanged;
        Backend.Changed -= OnBackendStateChanged;
    }

    private void OnScreenChanged(string id)
    {
        var route = id switch
        {
            "dashboard"   => "/",
            "buildings"   => "/buildings",
            "devices"     => "/devices",
            "groups"      => "/groups",
            "designer"    => "/designer",
            "tests"       => "/tests",
            "schedule"    => "/schedule",
            "reservation" => "/reservation",
            _             => "/",
        };
        Nav.NavigateTo(route);
    }
}
