@page "/tests"
@inject IClientService Client

<PageTitle>Test-Groups · Resource.Scheduler</PageTitle>

<div class="rs-screen">
    <div class="rs-screen-head">
        <div>
            <div class="rs-screen-eyebrow">06 · Test-Groups</div>
            <h1 class="rs-screen-title">Test-Groups</h1>
            <p class="rs-screen-sub rs-mono-sm">
                @if (_loaded)
                {
                    @($"{_teams.Count} teams · {_people.Count} people")
                }
                else
                {
                    @("loading…")
                }
            </p>
        </div>
        <div class="rs-screen-actions">
            <button class="rs-btn rs-btn--primary" @onclick="OnNewTeam">+ New test-group</button>
        </div>
    </div>

    @if (_loaded)
    {
        <div class="rs-detail" style="grid-template-columns:320px 1fr">
            <div class="rs-detail-side" style="padding:0">
                <div class="rs-pane-head" style="padding:16px 20px">
                    <div class="rs-pane-title">
                        <span>Teams</span>
                        <span class="rs-mono-sm">@_teams.Count</span>
                    </div>
                </div>
                <div class="rs-stack-2" style="padding:8px">
                    @foreach (var t in _teams)
                    {
                        var team = t;
                        var isOpen = _selectedId == team.TestGroupId;
                        var border = isOpen ? "var(--rs-ink)" : "var(--rs-line)";
                        var bg = isOpen ? "var(--rs-bg)" : "var(--rs-surface-2)";
                        <div @onclick="() => Select(team.TestGroupId)"
                             style="@($"padding:12px;cursor:pointer;border:1px solid {border};background:{bg};border-radius:2px")">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                                <span style="font-weight:500">@team.Name</span>
                                <span class="rs-mono-sm">@team.MemberIds.Count people</span>
                            </div>
                            <AvatarCluster People="@MembersOf(team)" Max="5" />
                        </div>
                    }
                    @if (_teams.Count == 0)
                    {
                        <div class="rs-empty">No teams yet. Click "+ New test-group" to create one.</div>
                    }
                </div>
            </div>

            <div class="rs-detail-main">
                @if (_selected is not null)
                {
                    var sel = _selected;
                    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:16px">
                        <div>
                            <div class="rs-label">Editing</div>
                            <h2 style="margin:0;font-size:20px;font-weight:500">@sel.Name</h2>
                        </div>
                        <div class="rs-row">
                            <button class="rs-btn rs-btn--ghost" @onclick="OnRename">Rename</button>
                            <button class="rs-btn rs-btn--danger" @onclick="OnDelete">Delete team</button>
                        </div>
                    </div>

                    @if (_actionError is not null)
                    {
                        <div style="margin-bottom:12px">
                            <RuleViolationBanner RuleId="@_actionRuleId" Title="Cannot complete action">
                                @_actionError
                            </RuleViolationBanner>
                        </div>
                    }

                    <div class="rs-card" style="margin-bottom:16px">
                        <div class="rs-card-head">
                            <span class="rs-card-title">Members (@sel.MemberIds.Count)</span>
                            <span class="rs-mono-sm">remove with the X button</span>
                        </div>
                        <div class="rs-card-body">
                            @if (sel.MemberIds.Count == 0)
                            {
                                <div class="rs-empty">No members yet. Add people from the directory below.</div>
                            }
                            else
                            {
                                <div style="display:flex;flex-direction:column;gap:8px">
                                    @{ var idx = 0; }
                                    @foreach (var pid in sel.MemberIds)
                                    {
                                        var p = _peopleById.TryGetValue(pid, out var found) ? found : null;
                                        if (p is null) { continue; }
                                        var i = idx++;
                                        var personId = p.PersonId;
                                        <div style="display:flex;align-items:center;gap:12px;padding:10px;border:1px solid var(--rs-line);border-radius:2px;background:var(--rs-surface-2)">
                                            <Avatar Name="@p.Name" Idx="@i" Size="28" />
                                            <div style="flex:1">
                                                <div style="font-weight:500">@p.Name</div>
                                                <div class="rs-mono-sm">@(p.Email ?? string.Empty)</div>
                                            </div>
                                            <button class="rs-btn rs-btn--ghost rs-btn--sm"
                                                    title="Remove from team"
                                                    disabled="@_saving"
                                                    @onclick="() => RemoveMember(personId)">×</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="rs-card">
                        <div class="rs-card-head">
                            <span class="rs-card-title">People directory</span>
                            <span class="rs-row" style="gap:12px">
                                <span class="rs-mono-sm">click to add</span>
                                <button class="rs-btn rs-btn--ghost rs-btn--sm" @onclick="OnNewPerson">+ New person</button>
                            </span>
                        </div>
                        <div class="rs-card-body">
                            @{
                                var available = _people
                                    .Where(p => !sel.MemberIds.Contains(p.PersonId))
                                    .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                                    .ToList();
                            }
                            @if (available.Count == 0)
                            {
                                <div class="rs-empty">Everyone is already in this team.</div>
                            }
                            else
                            {
                                <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:8px">
                                    @{ var aIdx = 0; }
                                    @foreach (var pp in available)
                                    {
                                        var p = pp;
                                        var i = aIdx++;
                                        var personId = p.PersonId;
                                        <div @onclick="() => AddMember(personId)"
                                             style="display:flex;align-items:center;gap:10px;padding:8px;border:1px dashed var(--rs-line-2);border-radius:2px;cursor:pointer;background:var(--rs-surface-2)">
                                            <Avatar Name="@p.Name" Idx="@(i + 5)" Size="24" />
                                            <div style="flex:1">
                                                <div style="font-size:13px">@p.Name</div>
                                                <div class="rs-mono-sm">@(p.Email ?? string.Empty)</div>
                                            </div>
                                            <span class="rs-mono-sm">+ add</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="rs-empty">Select a team on the left, or click "+ New test-group" to create one.</div>
                }
            </div>
        </div>
    }
</div>

<TestGroupEditor TestGroup="_editTarget"
                 IsOpen="_editorOpen"
                 OnClose="OnEditorClose"
                 OnSaved="OnEditorSaved" />

@* Person create modal. Reuses the existing PersonEditor; on save we
   refresh the people list so the new person shows up in the directory
   on this page without a navigation round-trip. *@
<PersonEditor Person="null"
              IsOpen="_personEditorOpen"
              OnClose="OnPersonEditorClose"
              OnSaved="OnPersonSaved" />

@code {
    private bool _loaded;
    private bool _saving;
    private IReadOnlyList<TestGroupDto> _teams = Array.Empty<TestGroupDto>();
    private IReadOnlyList<PersonDto> _people = Array.Empty<PersonDto>();
    private Dictionary<Guid, PersonDto> _peopleById = new();

    private Guid? _selectedId;
    private TestGroupDto? _selected => _selectedId.HasValue
        ? _teams.FirstOrDefault(t => t.TestGroupId == _selectedId.Value)
        : null;

    private bool _editorOpen;
    private TestGroupDto? _editTarget;

    private bool _personEditorOpen;

    private string? _actionError;
    private string? _actionRuleId;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _selectedId = _teams.FirstOrDefault()?.TestGroupId;
        _loaded = true;
    }

    private async Task Reload()
    {
        _teams = await Client.ListTestGroupsAsync();
        _people = await Client.ListPeopleAsync();
        _peopleById = _people.ToDictionary(p => p.PersonId);
    }

    private IEnumerable<PersonDto> MembersOf(TestGroupDto team) =>
        team.MemberIds
            .Select(id => _peopleById.TryGetValue(id, out var p) ? p : null)
            .Where(p => p is not null)!
            .Cast<PersonDto>();

    private void Select(Guid id)
    {
        _selectedId = id;
        _actionError = null;
        _actionRuleId = null;
    }

    // ---------- Editor flow ----------

    private void OnNewTeam()
    {
        _editTarget = null;
        _editorOpen = true;
    }

    private void OnRename()
    {
        if (_selected is null) return;
        _editTarget = _selected;
        _editorOpen = true;
    }

    private void OnEditorClose() => _editorOpen = false;

    private async Task OnEditorSaved(TestGroupDto saved)
    {
        _editorOpen = false;
        await Reload();
        _selectedId = saved.TestGroupId;
    }

    // ---------- Add a new person without leaving this page ----------

    private void OnNewPerson() => _personEditorOpen = true;

    private void OnPersonEditorClose() => _personEditorOpen = false;

    private async Task OnPersonSaved(PersonDto _)
    {
        _personEditorOpen = false;
        // Refresh just the people list so the directory picks up the
        // new entry. The team list is unchanged.
        _people = await Client.ListPeopleAsync();
        _peopleById = _people.ToDictionary(p => p.PersonId);
    }

    // ---------- Delete ----------

    private async Task OnDelete()
    {
        if (_selected is null) return;
        _actionError = null;
        _actionRuleId = null;
        _saving = true;
        try
        {
            await Client.DeleteTestGroupAsync(_selected.TestGroupId, _selected.Version);
            await Reload();
            _selectedId = _teams.FirstOrDefault()?.TestGroupId;
        }
        catch (ValidationException ex)
        {
            _actionError = ex.Message;
            _actionRuleId = ex.RuleId;
        }
        catch (DomainException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------- Member add / remove ----------

    private Task AddMember(Guid personId)
    {
        if (_selected is null) return Task.CompletedTask;
        if (_selected.MemberIds.Contains(personId)) return Task.CompletedTask;
        var newIds = _selected.MemberIds.Append(personId).ToList();
        return SaveMembership(newIds);
    }

    private Task RemoveMember(Guid personId)
    {
        if (_selected is null) return Task.CompletedTask;
        if (!_selected.MemberIds.Contains(personId)) return Task.CompletedTask;
        var newIds = _selected.MemberIds.Where(id => id != personId).ToList();
        return SaveMembership(newIds);
    }

    private async Task SaveMembership(IReadOnlyList<Guid> newMemberIds)
    {
        if (_selected is null) return;
        _actionError = null;
        _actionRuleId = null;
        _saving = true;
        try
        {
            var saved = await Client.UpdateTestGroupAsync(
                _selected.TestGroupId,
                new TestGroupUpdate(_selected.Name, newMemberIds),
                _selected.Version);
            await Reload();
            _selectedId = saved.TestGroupId;
        }
        catch (ValidationException ex)
        {
            _actionError = ex.Message;
            _actionRuleId = ex.RuleId;
        }
        catch (ConflictException ex)
        {
            // Stale version: refresh and let the user retry.
            _actionError = $"{ex.Message} The team was changed elsewhere; the latest version has been loaded.";
            await Reload();
        }
        catch (DomainException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
