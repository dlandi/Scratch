@* Top-of-app header. Includes the SVG brand mark, primary navigation,
   and a small environment chip on the right. The actual screen routing
   is handled by the host app; this component just raises ScreenChanged. *@

<header class="rs-header">
    <div class="rs-header-top">
        <div class="rs-brand">
            <svg class="rs-brand-mark" viewBox="0 0 22 22">
                <rect x="1.5" y="1.5" width="19" height="19" rx="2" fill="none"
                      stroke="var(--rs-ink)" stroke-width="1.25" />
                <circle cx="6"  cy="6"  r="2" fill="var(--rs-ok)" />
                <circle cx="16" cy="6"  r="2" fill="var(--rs-ink)" />
                <circle cx="6"  cy="16" r="2" fill="var(--rs-ink)" />
                <circle cx="16" cy="16" r="2" fill="var(--rs-warn)" />
                <line x1="6"  y1="6"  x2="16" y2="6"  stroke="var(--rs-ink)" stroke-width="1" />
                <line x1="6"  y1="6"  x2="6"  y2="16" stroke="var(--rs-ink)" stroke-width="1" />
                <line x1="16" y1="6"  x2="16" y2="16" stroke="var(--rs-ink)" stroke-width="1" />
                <line x1="6"  y1="16" x2="16" y2="16" stroke="var(--rs-ink)" stroke-width="1" />
            </svg>
            <span class="rs-brand-name"><b>Resource</b><span>.</span><b>Scheduler</b></span>
        </div>
        <nav class="rs-nav">
            @foreach (var item in NavItems)
            {
                <button class="rs-nav-btn @(item.Id == ActiveScreen ? "is-active" : "")"
                        @onclick="@(() => OnNav(item.Id))">
                    <span class="num">@item.Num</span>
                    <span>@item.Label</span>
                </button>
            }
        </nav>
    </div>
    <div class="rs-header-sub">
        <span class="rs-store-chip">
            <span class="dot"></span>
            @if (CanSwitchBackend && BackendOptions.Count > 0)
            {
                <select class="rs-backend-select" title="@BackendTitle"
                        value="@CurrentBackendId" @onchange="OnBackendSelectChanged">
                    @foreach (var b in BackendOptions)
                    {
                        <option value="@b.Id">@b.Label</option>
                    }
                </select>
            }
            else
            {
                <span>@StoreLabel</span>
            }
        </span>
        @if (CanSwitchTimeZone && TimeZoneOptions.Count > 0)
        {
            <select class="rs-tz-select" title="@TimeZoneTitle"
                    value="@CurrentTimeZoneId" @onchange="OnTzSelectChanged">
                @foreach (var tz in TimeZoneOptions)
                {
                    <option value="@tz.Id">@FormatOption(tz)</option>
                }
            </select>
        }
        else
        {
            <span title="@TimeZoneTitle">@TimeZoneLabel</span>
        }
        <span>@Version</span>
    </div>
</header>

@code {
    private record NavItem(string Id, string Label, string Num);

    private static readonly NavItem[] NavItems =
    {
        new("dashboard",   "Dashboard",      "01"),
        new("buildings",   "Buildings",      "02"),
        new("devices",     "Devices",        "03"),
        new("groups",      "Device-Groups",  "04"),
        new("designer",    "Designer",       "05"),
        new("tests",       "Test-Groups",    "06"),
        new("schedule",    "Schedule",       "07"),
        new("reservation", "New Reservation","08"),
    };

    [Parameter] public string ActiveScreen { get; set; } = "dashboard";
    [Parameter] public EventCallback<string> ScreenChanged { get; set; }

    /// <summary>Right-hand environment label, e.g. "in-memory store" or "rust api".
    /// Used as the static fallback when <see cref="CanSwitchBackend"/> is false.</summary>
    [Parameter] public string StoreLabel { get; set; } = "in-memory store";

    /// <summary>When true, the store label becomes a dropdown that raises
    /// <see cref="BackendChanged"/> on selection. Driven by the
    /// <c>Features:BackendSwitcher:Enabled</c> appsettings flag.</summary>
    [Parameter] public bool CanSwitchBackend { get; set; }

    /// <summary>Available backends for the dropdown. Empty when the switcher is off.</summary>
    [Parameter] public IReadOnlyList<Services.BackendOption> BackendOptions { get; set; } =
        Array.Empty<Services.BackendOption>();

    /// <summary>The id of the currently selected backend (used as the select's value).</summary>
    [Parameter] public string CurrentBackendId { get; set; } = string.Empty;

    /// <summary>Hover-tooltip with a longer description of the active backend.</summary>
    [Parameter] public string BackendTitle { get; set; } = string.Empty;

    /// <summary>Raised with the chosen backend id when the user changes the dropdown.</summary>
    [Parameter] public EventCallback<string> BackendChanged { get; set; }

    [Parameter] public string Version { get; set; } = "v0.1";

    /// <summary>Short label for the host's local timezone, e.g. "UTC-04:00".
    /// All schedule times in the app render in this timezone; the label
    /// makes that explicit so users know what they're seeing.</summary>
    [Parameter] public string TimeZoneLabel { get; set; } = string.Empty;

    /// <summary>Hover-tooltip with the full timezone display name.</summary>
    [Parameter] public string TimeZoneTitle { get; set; } = string.Empty;

    /// <summary>When true, the timezone label becomes a dropdown that
    /// raises <see cref="TimeZoneChanged"/> on selection. Driven by the
    /// <c>Features:TimeZoneSwitcher:Enabled</c> appsettings flag.</summary>
    [Parameter] public bool CanSwitchTimeZone { get; set; }

    /// <summary>Available zones for the dropdown. Empty when the switcher is off.</summary>
    [Parameter] public IReadOnlyList<TimeZoneInfo> TimeZoneOptions { get; set; } = Array.Empty<TimeZoneInfo>();

    /// <summary>The id of the currently selected zone (used as the select's value).</summary>
    [Parameter] public string CurrentTimeZoneId { get; set; } = string.Empty;

    /// <summary>Raised with the chosen TimeZoneInfo.Id when the user changes the dropdown.</summary>
    [Parameter] public EventCallback<string> TimeZoneChanged { get; set; }

    private Task OnNav(string id) => ScreenChanged.InvokeAsync(id);

    private async Task OnTzSelectChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id))
        {
            await TimeZoneChanged.InvokeAsync(id);
        }
    }

    private async Task OnBackendSelectChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id))
        {
            await BackendChanged.InvokeAsync(id);
        }
    }

    private static string FormatOption(TimeZoneInfo tz)
    {
        var offset = tz.BaseUtcOffset;
        var sign = offset >= TimeSpan.Zero ? "+" : "-";
        return $"UTC{sign}{offset.Duration():hh\\:mm} · {tz.Id}";
    }
}
