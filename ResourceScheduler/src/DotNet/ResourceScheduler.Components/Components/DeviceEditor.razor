@* Device create/edit modal. Status enum is bound directly; the building
   select uses a Guid string round-trip because Blazor's @bind doesn't
   produce option values for record-typed selects cleanly. *@

@inject IClientService Client

<Modal IsOpen="IsOpen" Title="@TitleText" OnClose="OnClose">
    <ChildContent>
        @if (_error is not null)
        {
            <div style="margin-bottom: 16px">
                <RuleViolationBanner RuleId="@_errorRuleId" Title="Cannot save">
                    @_error
                </RuleViolationBanner>
            </div>
        }
        <div class="rs-form">
            <div class="rs-field rs-field--full">
                <label class="rs-label">Name</label>
                <input class="rs-input" @bind="_name" @bind:event="oninput" placeholder="Device name" />
            </div>
            <div class="rs-field">
                <label class="rs-label">Status</label>
                <select class="rs-select" @bind="_status">
                    @foreach (var s in Enum.GetValues<DeviceStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="rs-field">
                <label class="rs-label">Building</label>
                <select class="rs-select" @bind="_buildingId">
                    @if (Buildings.Count == 0)
                    {
                        <option value="">(no buildings on file)</option>
                    }
                    @foreach (var b in Buildings)
                    {
                        <option value="@b.BuildingId">@b.Name</option>
                    }
                </select>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="rs-btn rs-btn--ghost" @onclick="OnClose" disabled="@_saving">Cancel</button>
        <button type="button" class="rs-btn rs-btn--primary" @onclick="Save" disabled="@(_saving || string.IsNullOrWhiteSpace(_name) || _buildingId == Guid.Empty)">
            @(_saving ? "Saving…" : "Save")
        </button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public DeviceDto? Device { get; set; }
    [Parameter] public IReadOnlyList<BuildingDto> Buildings { get; set; } = Array.Empty<BuildingDto>();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<DeviceDto> OnSaved { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string _name = string.Empty;
    private DeviceStatus _status;
    private Guid _buildingId;
    private string? _error;
    private string? _errorRuleId;

    private string TitleText => Device is null ? "New device" : "Edit device";

    protected override Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            if (Device is null)
            {
                _name = string.Empty;
                _status = DeviceStatus.Available;
                // Default to first available building, or the first listed one.
                var defaultBuilding = Buildings.FirstOrDefault();
                _buildingId = defaultBuilding?.BuildingId ?? Guid.Empty;
            }
            else
            {
                _name = Device.Name;
                _status = Device.Status;
                _buildingId = Device.BuildingId;
            }
            _error = null;
            _errorRuleId = null;
            _saving = false;
        }
        _wasOpen = IsOpen;
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name) || _buildingId == Guid.Empty)
        {
            return;
        }

        _saving = true;
        _error = null;
        _errorRuleId = null;
        try
        {
            DeviceDto saved;
            if (Device is null)
            {
                saved = await Client.CreateDeviceAsync(new DeviceCreate(_name.Trim(), _status, _buildingId));
            }
            else
            {
                saved = await Client.UpdateDeviceAsync(
                    Device.DeviceId,
                    new DeviceUpdate(_name.Trim(), _status, _buildingId),
                    Device.Version);
            }
            await OnSaved.InvokeAsync(saved);
        }
        catch (ValidationException ex)
        {
            _error = ex.Message;
            _errorRuleId = ex.RuleId;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
