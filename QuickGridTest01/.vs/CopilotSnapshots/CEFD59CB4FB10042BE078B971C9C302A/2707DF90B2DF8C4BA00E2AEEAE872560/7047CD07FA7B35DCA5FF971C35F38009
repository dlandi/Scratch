using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.QuickGrid;
using Microsoft.AspNetCore.Components.Rendering;
using Microsoft.AspNetCore.Components.Web;
using Microsoft.Extensions.Logging;
using Microsoft.JSInterop;
using QuickGridTest01.LogDetail.Core;
using QuickGridTest01.LogDetail.Events;

namespace QuickGridTest01.LogDetail;

/// <summary>
/// Trigger mode for expanding log detail rows.
/// </summary>
public enum LogDetailTriggerMode
{
    /// <summary>Expand via explicit button click.</summary>
    Button,

    /// <summary>Expand via clicking anywhere on the row cell.</summary>
    RowClick
}

/// <summary>
/// Context passed to the CollapsedTemplate for rendering collapsed state.
/// </summary>
/// <typeparam name="TGridItem">The type of grid item</typeparam>
public class LogDetailDisplayContext<TGridItem> where TGridItem : class
{
    /// <summary>The current item.</summary>
    public required TGridItem Item { get; init; }

    /// <summary>Whether any row is currently expanded.</summary>
    public bool IsAnyRowExpanded { get; init; }

    /// <summary>Action to expand this row.</summary>
    public required Func<Task> ExpandAsync { get; init; }
}

/// <summary>
/// A QuickGrid column that renders expandable detail content for log entries.
/// Only one row can be expanded at a time. The detail panel appears below the 
/// master row as an overlay spanning a configurable number of rows.
/// Click outside the detail panel to close it.
/// </summary>
/// <typeparam name="TGridItem">The type of data item in the grid</typeparam>
/// <typeparam name="TKey">The type of key used to identify rows</typeparam>
public partial class LogDetailColumn<TGridItem, TKey> : ColumnBase<TGridItem>, IAsyncDisposable
    where TGridItem : class
    where TKey : notnull
{
    private readonly LogExpansionStateManager<TKey> _stateManager = new();
    private GridSort<TGridItem>? _sortBuilder;
    private bool _disposed;
    private bool _rowClickHandlerRegistered;
    private int _lastRenderIndex = -1;
    
    // Track items by their rendered order for row click mapping
    private readonly List<(TGridItem Item, TKey Key)> _renderedItems = new();
    
    // JS Interop for click-outside and row-click detection
    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _clickOutsideHandler;
    private IJSObjectReference? _rowClickHandler;
    private DotNetObjectReference<LogDetailColumn<TGridItem, TKey>>? _dotNetRef;
    private TGridItem? _currentExpandedItem;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILogger<LogDetailColumn<TGridItem, TKey>> Logger { get; set; } = default!;

    #region Parameters - Key & Trigger

    /// <summary>
    /// Function to extract a unique key from each item. Required.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<TGridItem, TKey> ItemKey { get; set; } = default!;

    /// <summary>
    /// How expansion is triggered. Default: RowClick.
    /// </summary>
    [Parameter]
    public LogDetailTriggerMode TriggerMode { get; set; } = LogDetailTriggerMode.RowClick;

    /// <summary>
    /// CSS selector for the QuickGrid table. Required when TriggerMode is RowClick.
    /// Example: ".my-grid" or "#log-grid"
    /// </summary>
    [Parameter]
    public string? GridSelector { get; set; }

    /// <summary>
    /// When true, only double-click triggers expansion (single click is ignored).
    /// Only applies when TriggerMode is RowClick. Default: false.
    /// </summary>
    [Parameter]
    public bool DoubleClickToExpand { get; set; } = false;

    /// <summary>
    /// When true, non-expanded rows are visually dimmed when any row is expanded. Default: false.
    /// </summary>
    [Parameter]
    public bool DimCollapsedRows { get; set; } = false;

    /// <summary>
    /// Number of rows the detail overlay should span vertically. Default: 4.
    /// Height is calculated as RowSpan × --grid-row-height (36px default).
    /// </summary>
    [Parameter]
    public int RowSpan { get; set; } = 4;

    #endregion

    #region Parameters - Templates

    /// <summary>
    /// Content shown when row is collapsed.
    /// If null and TriggerMode is Button, renders default expand button.
    /// </summary>
    [Parameter]
    public RenderFragment<LogDetailDisplayContext<TGridItem>>? CollapsedTemplate { get; set; }

    /// <summary>
    /// Content shown when row is expanded. Required.
    /// Receives LogDetailContext with the item and collapse action.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment<LogDetailContext<TGridItem>>? ExpandedTemplate { get; set; }

    #endregion

    #region Parameters - Button Customization

    /// <summary>
    /// Text for the expand button. Default: "▼ More".
    /// </summary>
    [Parameter]
    public string ExpandButtonText { get; set; } = "▼ More";

    /// <summary>
    /// Text for the collapse button. Default: "▲ Less".
    /// </summary>
    [Parameter]
    public string CollapseButtonText { get; set; } = "▲ Less";

    /// <summary>
    /// CSS class for the expand/collapse button. Default: "qg-btn qg-btn-ghost qg-btn-sm".
    /// </summary>
    [Parameter]
    public string ButtonClass { get; set; } = "qg-btn qg-btn-ghost qg-btn-sm";

    #endregion

    #region Parameters - Events

    /// <summary>
    /// Called when a row is expanded.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailExpandedEventArgs<TGridItem>> OnExpanded { get; set; }

    /// <summary>
    /// Called when a row is collapsed.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailCollapsedEventArgs<TGridItem>> OnCollapsed { get; set; }

    /// <summary>
    /// Called before expanding a row. Set Cancel = true to prevent.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailBeforeExpandEventArgs<TGridItem>> OnBeforeExpand { get; set; }

    #endregion

    #region ColumnBase Implementation

    public override GridSort<TGridItem>? SortBy
    {
        get => _sortBuilder;
        set => _sortBuilder = value;
    }

    protected override void OnParametersSet()
    {
        if (ItemKey == null)
            throw new InvalidOperationException($"{nameof(LogDetailColumn<TGridItem, TKey>)} requires an {nameof(ItemKey)} parameter.");

        if (ExpandedTemplate == null)
            throw new InvalidOperationException($"{nameof(LogDetailColumn<TGridItem, TKey>)} requires an {nameof(ExpandedTemplate)} parameter.");

        if (TriggerMode == LogDetailTriggerMode.RowClick && string.IsNullOrEmpty(GridSelector))
            throw new InvalidOperationException($"{nameof(LogDetailColumn<TGridItem, TKey>)} requires a {nameof(GridSelector)} parameter when {nameof(TriggerMode)} is {nameof(LogDetailTriggerMode.RowClick)}.");

        if (string.IsNullOrEmpty(Title))
            Title = "";

        base.OnParametersSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TriggerMode == LogDetailTriggerMode.RowClick && !_rowClickHandlerRegistered)
        {
            await RegisterRowClickHandlerAsync();
        }
        
        // Reset render tracking for next render cycle
        _lastRenderIndex = -1;
        
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void CellContent(RenderTreeBuilder builder, TGridItem item)
    {
        var key = ItemKey(item);
        var isExpanded = _stateManager.IsExpanded(key);
        var hasAnyExpanded = _stateManager.HasExpandedRows;

        // Track this item for row click mapping
        // Check if this key already exists to detect new render cycle
        var existingIndex = _renderedItems.FindIndex(x => EqualityComparer<TKey>.Default.Equals(x.Key, key));
        if (existingIndex >= 0)
        {
            // This key already exists - must be a new render cycle, clear and start fresh
            _renderedItems.Clear();
        }
        _renderedItems.Add((item, key));
        
        System.Diagnostics.Debug.WriteLine($"CellContent: Added key={key}, total items={_renderedItems.Count}");

        int seq = 0;

        // Wrapper div with state classes and CSS variable for row span
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", BuildCellClass(isExpanded, hasAnyExpanded));
        builder.AddAttribute(seq++, "style", $"--row-span: {RowSpan}");
        builder.AddAttribute(seq++, "data-log-detail-key", key?.ToString());

        if (isExpanded)
        {
            RenderExpandedMode(builder, ref seq, item, key);
        }
        else
        {
            RenderCollapsedMode(builder, ref seq, item, key, hasAnyExpanded);
        }

        builder.CloseElement();
    }

    #endregion

    #region Rendering

    private void RenderCollapsedMode(RenderTreeBuilder builder, ref int seq, TGridItem item, TKey key, bool hasAnyExpanded)
    {
        var displayContext = new LogDetailDisplayContext<TGridItem>
        {
            Item = item,
            IsAnyRowExpanded = hasAnyExpanded,
            ExpandAsync = () => ExpandRowAsync(item, key)
        };

        if (CollapsedTemplate != null)
        {
            builder.AddContent(seq++, CollapsedTemplate(displayContext));
        }
        else if (TriggerMode == LogDetailTriggerMode.Button)
        {
            RenderDefaultExpandButton(builder, ref seq, displayContext, key);
        }
        else if (TriggerMode == LogDetailTriggerMode.RowClick)
        {
            var detailId = $"log-detail-{key}";
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "log-detail-click-target");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "tabindex", "0");
            builder.AddAttribute(seq++, "aria-expanded", "false");
            builder.AddAttribute(seq++, "aria-controls", detailId);
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await displayContext.ExpandAsync()));
            builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, async e =>
            {
                if (e.Key is "Enter" or " ")
                    await displayContext.ExpandAsync();
            }));
            builder.AddAttribute(seq++, "title", "Click to expand details");
            
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "log-detail-expand-icon");
            builder.AddContent(seq++, "▼");
            builder.CloseElement();
            
            builder.CloseElement();
        }
    }

    private void RenderDefaultExpandButton(RenderTreeBuilder builder, ref int seq, LogDetailDisplayContext<TGridItem> context, TKey key)
    {
        var detailId = $"log-detail-{key}";
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", ButtonClass);
        builder.AddAttribute(seq++, "aria-expanded", "false");
        builder.AddAttribute(seq++, "aria-controls", detailId);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await context.ExpandAsync()));
        builder.AddAttribute(seq++, "title", "Expand details");

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, ExpandButtonText);
        builder.CloseElement();

        builder.CloseElement();
    }

    private void RenderExpandedMode(RenderTreeBuilder builder, ref int seq, TGridItem item, TKey key)
    {
        // Create context for expanded template
        var context = new LogDetailContext<TGridItem>
        {
            Item = item,
            IsExpanded = true,
            CollapseAsync = () => CollapseRowAsync(item, key)
        };

        var detailId = $"log-detail-{key}";

        // Collapse button in cell
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", $"{ButtonClass} log-detail-collapse-trigger");
        builder.AddAttribute(seq++, "aria-expanded", "true");
        builder.AddAttribute(seq++, "aria-controls", detailId);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await context.CollapseAsync()));
        builder.AddAttribute(seq++, "title", "Collapse details");
        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, CollapseButtonText);
        builder.CloseElement();
        builder.CloseElement();

        // Detail overlay positioned below the row
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "id", detailId);
        builder.AddAttribute(seq++, "class", "log-detail-overlay");
        builder.AddAttribute(seq++, "role", "region");
        builder.AddAttribute(seq++, "aria-label", "Log entry details");

        // Render the user's template content
        builder.AddContent(seq++, ExpandedTemplate!(context));

        builder.CloseElement(); // div.log-detail-overlay
    }

    private string BuildCellClass(bool isExpanded, bool hasAnyExpanded)
    {
        var classes = new List<string> { "log-detail-cell" };

        if (isExpanded)
        {
            classes.Add("log-detail-expanded");
        }
        else if (hasAnyExpanded && DimCollapsedRows)
        {
            classes.Add("log-detail-dimmed");
        }

        return string.Join(" ", classes);
    }

    #endregion

    #region Expansion Management

    private async Task ExpandRowAsync(TGridItem item, TKey key)
    {
        // Fire before-expand event
        var beforeExpandArgs = new LogDetailBeforeExpandEventArgs<TGridItem> { Item = item };
        await OnBeforeExpand.InvokeAsync(beforeExpandArgs);

        if (beforeExpandArgs.Cancel)
            return;

        // Collapse any previously expanded row and clean up its click handler
        if (_stateManager.HasExpandedRows)
        {
            await UnregisterClickOutsideAsync();
        }

        // Expand the new row
        await _stateManager.ExpandAsync(key);
        _currentExpandedItem = item;

        // Fire expanded event
        await OnExpanded.InvokeAsync(new LogDetailExpandedEventArgs<TGridItem>
        {
            Item = item,
            Key = key
        });

        await InvokeAsync(StateHasChanged);

        // Register click-outside handler after render
        await RegisterClickOutsideAsync(key);
    }

    private async Task CollapseRowAsync(TGridItem item, TKey key)
    {
        await UnregisterClickOutsideAsync();
        
        var wasCollapsed = await _stateManager.CollapseAsync(key);

        if (wasCollapsed)
        {
            _currentExpandedItem = default;
            
            // Fire collapsed event
            await OnCollapsed.InvokeAsync(new LogDetailCollapsedEventArgs<TGridItem>
            {
                Item = item,
                Key = key
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleRowAsync(TGridItem item, TKey key)
    {
        if (_stateManager.IsExpanded(key))
        {
            await CollapseRowAsync(item, key);
        }
        else
        {
            await ExpandRowAsync(item, key);
        }
    }

    /// <summary>
    /// Programmatically collapse all expanded rows.
    /// </summary>
    public async Task CollapseAllAsync()
    {
        await UnregisterClickOutsideAsync();
        await _stateManager.CollapseAllAsync();
        _currentExpandedItem = default;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Called from JavaScript when a row is clicked.
    /// </summary>
    /// <param name="rowIndex">The 0-based index of the clicked row in the visible rows.</param>
    [JSInvokable]
    public async Task OnRowClicked(int rowIndex)
    {
        System.Diagnostics.Debug.WriteLine($"OnRowClicked: rowIndex={rowIndex}, _renderedItems.Count={_renderedItems.Count}");
        
        if (rowIndex < 0 || rowIndex >= _renderedItems.Count)
        {
            System.Diagnostics.Debug.WriteLine($"OnRowClicked: Invalid index. rowIndex={rowIndex}, count={_renderedItems.Count}");
            return;
        }

        var (item, key) = _renderedItems[rowIndex];
        System.Diagnostics.Debug.WriteLine($"OnRowClicked: Toggling item with key={key}");
        await ToggleRowAsync(item, key);
    }

    /// <summary>
    /// Called from JavaScript when a click occurs outside the detail panel.
    /// </summary>
    [JSInvokable]
    public async Task OnClickOutside()
    {
        if (_stateManager.ExpandedKey is { } key && _currentExpandedItem is not null)
        {
            await CollapseRowAsync(_currentExpandedItem, key);
        }
    }

    #endregion

    #region JS Interop

    private async Task RegisterRowClickHandlerAsync()
    {
        if (string.IsNullOrEmpty(GridSelector) || _rowClickHandlerRegistered)
            return;

        try
        {
            // Collocated JS files in Blazor Server (.NET 8+) are served relative to web root
            // Component at /LogDetail/LogDetailColumn.razor → JS at /LogDetail/LogDetailColumn.razor.js
            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "/LogDetail/LogDetailColumn.razor.js");

            _dotNetRef ??= DotNetObjectReference.Create(this);

            var options = new { doubleClickOnly = DoubleClickToExpand, excludeSelector = (string?)null };
            _rowClickHandler = await _jsModule.InvokeAsync<IJSObjectReference>(
                "registerRowClickHandler", _dotNetRef, GridSelector, options);

            _rowClickHandlerRegistered = true;
        }
        catch (JSException ex)
        {
            Console.WriteLine($"LogDetailColumn: Failed to register row click handler: {ex.Message}");
        }
    }

    private async Task UnregisterRowClickHandlerAsync()
    {
        if (_rowClickHandler is not null && _jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("unregisterRowClickHandler", _rowClickHandler);
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
            _rowClickHandler = null;
            _rowClickHandlerRegistered = false;
        }
    }

    private async Task RegisterClickOutsideAsync(TKey key)
    {
        try
        {
            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "/LogDetail/LogDetailColumn.razor.js");
            
            _dotNetRef ??= DotNetObjectReference.Create(this);

            var elementId = $"log-detail-{key}";
            _clickOutsideHandler = await _jsModule.InvokeAsync<IJSObjectReference>(
                "registerClickOutside", _dotNetRef, elementId);
        }
        catch (JSException)
        {
            // JS interop not available (e.g., prerendering)
        }
    }

    private async Task UnregisterClickOutsideAsync()
    {
        if (_clickOutsideHandler is not null && _jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("unregisterClickOutside", _clickOutsideHandler);
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
            _clickOutsideHandler = null;
        }
    }

    #endregion

    #region IAsyncDisposable

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;

        await UnregisterRowClickHandlerAsync();
        await UnregisterClickOutsideAsync();
        
        _dotNetRef?.Dispose();
        
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
        }

        _renderedItems.Clear();
        _stateManager.Dispose();
        _disposed = true;
    }

    #endregion
}
