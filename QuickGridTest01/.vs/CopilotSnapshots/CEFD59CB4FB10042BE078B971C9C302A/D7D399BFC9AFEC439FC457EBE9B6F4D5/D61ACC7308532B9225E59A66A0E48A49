@page "/log-viewer-demo"
@using Microsoft.AspNetCore.Components.QuickGrid
@using global::QuickGridTest01.LogDetail
@using global::QuickGridTest01.LogDetail.Core
@using global::QuickGridTest01.LogDetail.Events

<h1>Log Viewer Demo</h1>
<p class="lead">Demonstrates <code>LogDetailColumn</code> with expandable log details, using 10,000+ sample entries.</p>

<div class="toolbar">
    <div class="toolbar-group">
        <label>
            <input type="checkbox" @bind="DimCollapsedRows" />
            Dim collapsed rows
        </label>
    </div>
    <div class="toolbar-group">
        <label>Trigger Mode:</label>
        <select @bind="TriggerMode">
            <option value="@LogDetailTriggerMode.Button">Button</option>
            <option value="@LogDetailTriggerMode.RowClick">Row Click</option>
        </select>
    </div>
    <div class="toolbar-group">
        <button class="qg-btn qg-btn-secondary qg-btn-sm" @onclick="CollapseAll">
            Collapse All
        </button>
        <button class="qg-btn qg-btn-secondary qg-btn-sm" @onclick="RegenerateData">
            Regenerate Data
        </button>
    </div>
    <div class="toolbar-stats">
        <span>Total: @_logs.Count entries</span>
        <span>Expanded: @_expandedCount</span>
    </div>
</div>

<div class="grid-container">
    <QuickGrid Items="@_filteredLogs" TGridItem="LogEntryModel" ItemKey="@(x => x.Id)">
        <PropertyColumn Property="@(x => x.Timestamp)" Title="Timestamp" Format="yyyy-MM-dd HH:mm:ss" Sortable="true" />
        <PropertyColumn Property="@(x => x.SourceContext)" Title="Source" Sortable="true" />
        <TemplateColumn Title="Level" Sortable="true" SortBy="@(GridSort<LogEntryModel>.ByAscending(x => x.Level))">
            <span class="level-badge level-@context.Level.ToLowerInvariant()">@context.Level</span>
        </TemplateColumn>
        <TemplateColumn Title="Message">
            <span class="message-preview" title="@context.Message">@Truncate(context.Message, 60)</span>
        </TemplateColumn>
        <LogDetailColumn TGridItem="LogEntryModel" 
                         TKey="int" 
                         ItemKey="@(x => x.Id)"
                         @ref="_logDetailColumn"
                         Title="Details"
                         TriggerMode="@TriggerMode"
                         DimCollapsedRows="@DimCollapsedRows"
                         ExpandButtonText="More"
                         CollapseButtonText="Less"
                         OnExpanded="OnRowExpanded"
                         OnCollapsed="OnRowCollapsed">
            <ExpandedTemplate Context="ctx">
                <div class="log-detail-content">
                    <div class="log-detail-header">
                        <span class="level-badge level-@ctx.Item.Level.ToLowerInvariant()">@ctx.Item.Level</span>
                        <span class="timestamp">@ctx.Item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                    </div>
                    <div class="log-detail-source">
                        <strong>Source:</strong> @ctx.Item.SourceContext
                    </div>
                    <div class="log-detail-message">
                        <strong>Message:</strong>
                        <pre>@ctx.Item.Message</pre>
                    </div>
                    @if (!string.IsNullOrEmpty(ctx.Item.Exception))
                    {
                        <div class="log-detail-exception">
                            <strong>Exception:</strong>
                            <pre class="exception-text">@ctx.Item.Exception</pre>
                        </div>
                    }
                    @if (ctx.Item.Properties.Count > 0)
                    {
                        <div class="log-detail-properties">
                            <strong>Properties:</strong>
                            <dl>
                                @foreach (var prop in ctx.Item.Properties)
                                {
                                    <dt>@prop.Key</dt>
                                    <dd>@prop.Value</dd>
                                }
                            </dl>
                        </div>
                    }
                </div>
            </ExpandedTemplate>
        </LogDetailColumn>
    </QuickGrid>
</div>

<Paginator State="@_pagination" />

@code {
    private List<LogEntryModel> _logs = new();
    private IQueryable<LogEntryModel> _filteredLogs => _logs.AsQueryable();
    private PaginationState _pagination = new() { ItemsPerPage = 50 };
    private LogDetailColumn<LogEntryModel, int>? _logDetailColumn;
    private int _expandedCount;

    // Parameters for demo configuration
    private bool DimCollapsedRows { get; set; } = false;
    private LogDetailTriggerMode TriggerMode { get; set; } = LogDetailTriggerMode.Button;

    protected override void OnInitialized()
    {
        GenerateSampleData(10_000);
    }

    private void GenerateSampleData(int count)
    {
        var random = new Random(42); // Fixed seed for reproducibility
        var levels = new[] { "Debug", "Information", "Warning", "Error", "Fatal" };
        var sources = new[]
        {
            "SmartShield.Monitor",
            "SmartOptimize.Engine", 
            "IPM_Site.EventLog",
            "DTN.NetworkManager",
            "Auth.SecurityService",
            "Database.ConnectionPool",
            "API.RequestHandler",
            "Cache.MemoryManager"
        };
        
        var messageTemplates = new[]
        {
            "Processing request {RequestId} for user {UserId}",
            "Connection established to {Endpoint} in {Duration}ms",
            "Cache hit ratio: {HitRatio}% for key pattern {Pattern}",
            "Authentication successful for {Username} from {IpAddress}",
            "Database query completed in {Duration}ms, rows affected: {RowCount}",
            "Memory usage threshold exceeded: {Current}MB / {Max}MB",
            "API rate limit approaching for client {ClientId}: {Current}/{Limit}",
            "Background job {JobId} completed with status: {Status}",
            "Configuration reloaded, {ChangeCount} settings updated",
            "Health check passed for service {ServiceName}, latency: {Latency}ms"
        };

        var exceptionMessages = new[]
        {
            null,
            null,
            null,
            null, // Most entries have no exception
            "System.NullReferenceException: Object reference not set to an instance of an object.\n   at MyApp.Services.DataProcessor.Process(Data data)\n   at MyApp.Controllers.ApiController.HandleRequest(Request req)",
            "System.TimeoutException: The operation has timed out.\n   at System.Net.Http.HttpClient.SendAsync(HttpRequestMessage request)\n   at MyApp.Services.ExternalApi.CallAsync()",
            "System.InvalidOperationException: Sequence contains no elements\n   at System.Linq.Enumerable.First[TSource](IEnumerable`1 source)\n   at MyApp.Repository.GetById(Int32 id)"
        };

        _logs = Enumerable.Range(1, count)
            .Select(i =>
            {
                var level = levels[WeightedRandom(random, new[] { 40, 35, 15, 8, 2 })];
                var hasException = level is "Error" or "Fatal" && random.NextDouble() < 0.7;
                
                return new LogEntryModel
                {
                    Id = i,
                    Timestamp = DateTime.Now.AddMinutes(-count + i).AddSeconds(random.Next(0, 60)),
                    Level = level,
                    SourceContext = sources[random.Next(sources.Length)],
                    Message = GenerateMessage(messageTemplates[random.Next(messageTemplates.Length)], random),
                    Exception = hasException ? exceptionMessages[random.Next(4, exceptionMessages.Length)] : null,
                    Properties = GenerateProperties(random)
                };
            })
            .OrderByDescending(x => x.Timestamp)
            .ToList();

        _expandedCount = 0;
    }

    private static int WeightedRandom(Random random, int[] weights)
    {
        var total = weights.Sum();
        var roll = random.Next(total);
        var cumulative = 0;
        for (int i = 0; i < weights.Length; i++)
        {
            cumulative += weights[i];
            if (roll < cumulative) return i;
        }
        return weights.Length - 1;
    }

    private static string GenerateMessage(string template, Random random)
    {
        return template
            .Replace("{RequestId}", Guid.NewGuid().ToString("N")[..8])
            .Replace("{UserId}", random.Next(1000, 9999).ToString())
            .Replace("{Endpoint}", $"https://api.example.com/v{random.Next(1, 4)}")
            .Replace("{Duration}", random.Next(1, 5000).ToString())
            .Replace("{HitRatio}", random.Next(60, 99).ToString())
            .Replace("{Pattern}", $"user:*:session")
            .Replace("{Username}", $"user{random.Next(100, 999)}")
            .Replace("{IpAddress}", $"192.168.{random.Next(1, 255)}.{random.Next(1, 255)}")
            .Replace("{RowCount}", random.Next(0, 1000).ToString())
            .Replace("{Current}", random.Next(100, 900).ToString())
            .Replace("{Max}", "1024")
            .Replace("{ClientId}", $"client-{random.Next(100, 999)}")
            .Replace("{Limit}", "1000")
            .Replace("{JobId}", Guid.NewGuid().ToString("N")[..12])
            .Replace("{Status}", random.NextDouble() > 0.1 ? "Success" : "Failed")
            .Replace("{ChangeCount}", random.Next(1, 20).ToString())
            .Replace("{ServiceName}", $"svc-{random.Next(1, 10)}")
            .Replace("{Latency}", random.Next(1, 100).ToString());
    }

    private static Dictionary<string, string> GenerateProperties(Random random)
    {
        if (random.NextDouble() > 0.3) return new();
        
        var props = new Dictionary<string, string>();
        if (random.NextDouble() > 0.5) props["MachineName"] = $"SERVER-{random.Next(1, 20):D2}";
        if (random.NextDouble() > 0.5) props["ThreadId"] = random.Next(1, 100).ToString();
        if (random.NextDouble() > 0.5) props["CorrelationId"] = Guid.NewGuid().ToString();
        return props;
    }

    private static string Truncate(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "…";
    }

    private async Task CollapseAll()
    {
        if (_logDetailColumn != null)
        {
            await _logDetailColumn.CollapseAllAsync();
            _expandedCount = 0;
        }
    }

    private void RegenerateData()
    {
        GenerateSampleData(10_000);
        _expandedCount = 0;
        StateHasChanged();
    }

    private void OnRowExpanded(LogDetailExpandedEventArgs<LogEntryModel> args)
    {
        _expandedCount++;
    }

    private void OnRowCollapsed(LogDetailCollapsedEventArgs<LogEntryModel> args)
    {
        _expandedCount = Math.Max(0, _expandedCount - 1);
    }

    /// <summary>
    /// Log entry model for the demo, matching the structure from QuickGrid-Implementation-Plan.md
    /// </summary>
    public class LogEntryModel
    {
        public int Id { get; set; }
        public DateTime Timestamp { get; set; }
        public string SourceContext { get; set; } = string.Empty;
        public string Level { get; set; } = "Information";
        public string Message { get; set; } = string.Empty;
        public string? Exception { get; set; }
        public Dictionary<string, string> Properties { get; set; } = new();
    }
}
