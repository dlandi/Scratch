/* LogViewerDemo.razor.css - Scoped styles for QuickGrid with LogDetailColumn */

/* ============================================================================
   TOOLBAR
   ========================================================================= */

.toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-canvas, #FAFAF9);
    border-radius: var(--card-radius, 4px);
    margin-bottom: 1rem;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.toolbar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary, #525252);
}

.toolbar-stats {
    margin-left: auto;
    display: flex;
    gap: 1rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-tertiary, #737373);
}

/* ============================================================================
   LOG LEVEL BADGES (in grid cells)
   ========================================================================= */

.log-level-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1, 2px) var(--space-4, 8px);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--letter-spacing-wide, 0.02em);
    text-transform: uppercase;
    border-radius: 0.75rem;
    white-space: nowrap;
}

.log-level-badge.level-debug {
    background-color: var(--color-canvas, #FAFAF9);
    color: var(--color-text-tertiary, #737373);
    border: 1px solid var(--color-border-default, #E7E5E4);
}

.log-level-badge.level-information {
    background-color: var(--color-info-subtle, #F0F9FF);
    color: var(--color-info, #0284C7);
    border: 1px solid var(--color-info-border, #BAE6FD);
}

.log-level-badge.level-warning {
    background-color: var(--color-warning-subtle, #FFFBEB);
    color: var(--color-warning, #D97706);
    border: 1px solid var(--color-warning-border, #FED7AA);
}

.log-level-badge.level-error {
    background-color: var(--color-error-subtle, #FEF2F2);
    color: var(--color-error, #DC2626);
    border: 1px solid var(--color-error-border, #FECACA);
}

.log-level-badge.level-fatal {
    background-color: var(--color-error, #DC2626);
    color: #FFFFFF;
    border: 1px solid var(--color-error, #DC2626);
}

/* ============================================================================
   MESSAGE CELL
   ========================================================================= */

.log-message-cell {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-secondary, #525252);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 400px;
}

/* ============================================================================
   GRID CONTAINER ADJUSTMENTS
   Ensure proper positioning context for detail overlay
   ========================================================================= */

.qg-grid-container {
    position: relative;
    overflow: visible; /* Allow overlay to extend beyond container */
    margin-bottom: 200px; /* Space for overlay when last rows are expanded */
}

/* Ensure table rows support absolute positioning of overlay */
::deep .qg-grid tbody tr {
    position: relative;
}

/* Ensure proper z-index stacking when a row has expanded detail */
::deep .qg-grid tbody tr:has(.log-detail-expanded) {
    z-index: 10;
}

/* ============================================================================
   RESPONSIVE
   ========================================================================= */

@media (max-width: 768px) {
    .toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    .toolbar-stats {
        margin-left: 0;
        justify-content: center;
    }
    
    .log-message-cell {
        max-width: 200px;
    }
}
