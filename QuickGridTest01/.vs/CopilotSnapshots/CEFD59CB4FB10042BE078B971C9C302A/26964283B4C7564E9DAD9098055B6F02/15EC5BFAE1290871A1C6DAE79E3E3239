/* LogViewerDemo.razor.css - Scoped styles for Log Viewer with LogDetailColumn */

/* ============================================================================
   TOOLBAR
   ========================================================================= */

.toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--color-canvas, #FAFAF9);
    border-radius: var(--card-radius, 4px);
    margin-bottom: 1rem;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.toolbar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary, #525252);
}

.toolbar-stats {
    margin-left: auto;
    display: flex;
    gap: 1rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-tertiary, #737373);
}

/* ============================================================================
   LOG LEVEL BADGES (in grid cells)
   ========================================================================= */

.log-level-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1, 2px) var(--space-4, 8px);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--letter-spacing-wide, 0.02em);
    text-transform: uppercase;
    border-radius: 0.75rem;
    white-space: nowrap;
}

.log-level-badge.level-debug {
    background-color: var(--color-canvas, #FAFAF9);
    color: var(--color-text-tertiary, #737373);
    border: 1px solid var(--color-border-default, #E7E5E4);
}

.log-level-badge.level-information {
    background-color: var(--color-info-subtle, #F0F9FF);
    color: var(--color-info, #0284C7);
    border: 1px solid var(--color-info-border, #BAE6FD);
}

.log-level-badge.level-warning {
    background-color: var(--color-warning-subtle, #FFFBEB);
    color: var(--color-warning, #D97706);
    border: 1px solid var(--color-warning-border, #FED7AA);
}

.log-level-badge.level-error {
    background-color: var(--color-error-subtle, #FEF2F2);
    color: var(--color-error, #DC2626);
    border: 1px solid var(--color-error-border, #FECACA);
}

.log-level-badge.level-fatal {
    background-color: var(--color-error, #DC2626);
    color: #FFFFFF;
    border: 1px solid var(--color-error, #DC2626);
}

/* ============================================================================
   GRID CONTAINER
   ========================================================================= */

.qg-grid-container {
    position: relative;
    margin-bottom: 1rem;
}

/* Make rows appear clickable */
::deep .log-viewer-grid tbody tr {
    cursor: pointer;
    transition: background-color var(--duration-fast, 150ms) var(--ease-in-out);
}

::deep .log-viewer-grid tbody tr:hover {
    background-color: var(--color-accent-primary-subtle, #EFF6FF);
}

/* Row with expanded detail */
::deep .log-viewer-grid tbody tr:has(.log-detail-expanded) {
    position: relative;
    z-index: 10;
    background-color: var(--color-accent-primary-subtle, #EFF6FF);
}

/* ============================================================================
   LOG DETAIL CONTENT (inside overlay)
   ========================================================================= */

::deep .log-detail-content {
    padding: var(--space-16, 32px);
}

::deep .log-detail-header {
    display: flex;
    align-items: center;
    gap: var(--space-12, 24px);
    margin-bottom: var(--space-16, 32px);
    padding-bottom: var(--space-12, 24px);
    border-bottom: 1px solid var(--color-border-subtle, #F5F5F4);
}

::deep .log-detail-timestamp {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-tertiary, #737373);
}

::deep .log-detail-close {
    margin-left: auto;
    font-size: var(--font-size-base, 1rem);
    color: var(--color-text-tertiary, #737373);
}

::deep .log-detail-close:hover {
    color: var(--color-text-primary, #1A1A1A);
}

::deep .log-detail-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12, 24px);
}

::deep .log-detail-body strong {
    display: block;
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--letter-spacing-wide, 0.02em);
    text-transform: uppercase;
    color: var(--color-text-tertiary, #737373);
    margin-bottom: var(--space-4, 8px);
}

::deep .log-detail-body p {
    margin: 0;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary, #525252);
}

::deep .log-detail-body pre {
    margin: 0;
    padding: var(--space-12, 24px);
    background-color: var(--color-canvas, #FAFAF9);
    border: 1px solid var(--color-border-default, #E7E5E4);
    border-radius: var(--card-radius, 4px);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: var(--line-height-relaxed, 1.625);
    color: var(--color-text-primary, #1A1A1A);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
}

/* Exception styling */
::deep .log-detail-exception pre.exception {
    background-color: var(--color-error-subtle, #FEF2F2);
    border-color: var(--color-error-border, #FECACA);
    color: var(--color-error, #DC2626);
}

/* Properties list */
::deep .log-detail-body dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4, 8px) var(--space-16, 32px);
    margin: 0;
    padding: var(--space-12, 24px);
    background-color: var(--color-canvas, #FAFAF9);
    border: 1px solid var(--color-border-default, #E7E5E4);
    border-radius: var(--card-radius, 4px);
}

::deep .log-detail-body dt {
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-tertiary, #737373);
    font-size: var(--font-size-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide, 0.02em);
}

::deep .log-detail-body dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-secondary, #525252);
}

/* Log level badge in detail header */
::deep .log-detail-level {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1, 2px) var(--space-6, 12px);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--letter-spacing-wide, 0.02em);
    text-transform: uppercase;
    border-radius: 0.75rem;
    white-space: nowrap;
}

::deep .log-detail-level.level-debug {
    background-color: var(--color-canvas, #FAFAF9);
    color: var(--color-text-tertiary, #737373);
    border: 1px solid var(--color-border-default, #E7E5E4);
}

::deep .log-detail-level.level-information {
    background-color: var(--color-info-subtle, #F0F9FF);
    color: var(--color-info, #0284C7);
    border: 1px solid var(--color-info-border, #BAE6FD);
}

::deep .log-detail-level.level-warning {
    background-color: var(--color-warning-subtle, #FFFBEB);
    color: var(--color-warning, #D97706);
    border: 1px solid var(--color-warning-border, #FED7AA);
}

::deep .log-detail-level.level-error {
    background-color: var(--color-error-subtle, #FEF2F2);
    color: var(--color-error, #DC2626);
    border: 1px solid var(--color-error-border, #FECACA);
}

::deep .log-detail-level.level-fatal {
    background-color: var(--color-error, #DC2626);
    color: #FFFFFF;
    border: 1px solid var(--color-error, #DC2626);
}

/* ============================================================================
   RESPONSIVE
   ========================================================================= */

@media (max-width: 768px) {
    .toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    .toolbar-stats {
        margin-left: 0;
        justify-content: center;
    }
    
    ::deep .log-detail-content {
        padding: var(--space-12, 24px);
    }
    
    ::deep .log-detail-body dl {
        grid-template-columns: 1fr;
    }
}
