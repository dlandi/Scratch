using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.QuickGrid;
using Microsoft.AspNetCore.Components.Rendering;
using Microsoft.AspNetCore.Components.Web;
using QuickGridTest01.LogDetail.Core;
using QuickGridTest01.LogDetail.Events;

namespace QuickGridTest01.LogDetail;

/// <summary>
/// Trigger mode for expanding log detail rows.
/// </summary>
public enum LogDetailTriggerMode
{
    /// <summary>Expand via explicit button click.</summary>
    Button,

    /// <summary>Expand via clicking anywhere on the row cell.</summary>
    RowClick
}

/// <summary>
/// Context passed to the CollapsedTemplate for rendering collapsed state.
/// </summary>
/// <typeparam name="TGridItem">The type of grid item</typeparam>
public class LogDetailDisplayContext<TGridItem> where TGridItem : class
{
    /// <summary>The current item.</summary>
    public required TGridItem Item { get; init; }

    /// <summary>Whether any row is currently expanded.</summary>
    public bool IsAnyRowExpanded { get; init; }

    /// <summary>Action to expand this row.</summary>
    public required Func<Task> ExpandAsync { get; init; }
}

/// <summary>
/// A QuickGrid column that renders expandable detail content for log entries.
/// Supports multiple simultaneous expansions (unlike form editing).
/// Optimized for read-only detail display with no validation overhead.
/// </summary>
/// <typeparam name="TGridItem">The type of data item in the grid</typeparam>
/// <typeparam name="TKey">The type of key used to identify rows</typeparam>
public class LogDetailColumn<TGridItem, TKey> : ColumnBase<TGridItem>, IDisposable
    where TGridItem : class
    where TKey : notnull
{
    private readonly LogExpansionStateManager<TKey> _stateManager = new();
    private GridSort<TGridItem>? _sortBuilder;
    private bool _disposed;

    #region Parameters - Key & Trigger

    /// <summary>
    /// Function to extract a unique key from each item. Required.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<TGridItem, TKey> ItemKey { get; set; } = default!;

    /// <summary>
    /// How expansion is triggered. Default: Button.
    /// </summary>
    [Parameter]
    public LogDetailTriggerMode TriggerMode { get; set; } = LogDetailTriggerMode.Button;

    /// <summary>
    /// When true, non-expanded rows are visually dimmed when any row is expanded. Default: false.
    /// </summary>
    [Parameter]
    public bool DimCollapsedRows { get; set; } = false;

    #endregion

    #region Parameters - Templates

    /// <summary>
    /// Content shown when row is collapsed.
    /// If null and TriggerMode is Button, renders default expand button.
    /// </summary>
    [Parameter]
    public RenderFragment<LogDetailDisplayContext<TGridItem>>? CollapsedTemplate { get; set; }

    /// <summary>
    /// Content shown when row is expanded. Required.
    /// Receives LogDetailContext with the item and collapse action.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment<LogDetailContext<TGridItem>>? ExpandedTemplate { get; set; }

    #endregion

    #region Parameters - Button Customization

    /// <summary>
    /// Text for the expand button. Default: "More".
    /// </summary>
    [Parameter]
    public string ExpandButtonText { get; set; } = "More";

    /// <summary>
    /// Text for the collapse button. Default: "Less".
    /// </summary>
    [Parameter]
    public string CollapseButtonText { get; set; } = "Less";

    /// <summary>
    /// CSS class for the expand/collapse button. Default: "qg-btn qg-btn-link qg-btn-sm".
    /// </summary>
    [Parameter]
    public string ButtonClass { get; set; } = "qg-btn qg-btn-link qg-btn-sm";

    /// <summary>
    /// Icon class for expand button. Default: "bi bi-chevron-down".
    /// </summary>
    [Parameter]
    public string? ExpandIcon { get; set; } = "bi bi-chevron-down";

    /// <summary>
    /// Icon class for collapse button. Default: "bi bi-chevron-up".
    /// </summary>
    [Parameter]
    public string? CollapseIcon { get; set; } = "bi bi-chevron-up";

    #endregion

    #region Parameters - Events

    /// <summary>
    /// Called when a row is expanded.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailExpandedEventArgs<TGridItem>> OnExpanded { get; set; }

    /// <summary>
    /// Called when a row is collapsed.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailCollapsedEventArgs<TGridItem>> OnCollapsed { get; set; }

    /// <summary>
    /// Called before expanding a row. Set Cancel = true to prevent.
    /// </summary>
    [Parameter]
    public EventCallback<LogDetailBeforeExpandEventArgs<TGridItem>> OnBeforeExpand { get; set; }

    #endregion

    #region ColumnBase Implementation

    public override GridSort<TGridItem>? SortBy
    {
        get => _sortBuilder;
        set => _sortBuilder = value;
    }

    protected override void OnParametersSet()
    {
        if (ItemKey == null)
            throw new InvalidOperationException($"{nameof(LogDetailColumn<TGridItem, TKey>)} requires an {nameof(ItemKey)} parameter.");

        if (ExpandedTemplate == null)
            throw new InvalidOperationException($"{nameof(LogDetailColumn<TGridItem, TKey>)} requires an {nameof(ExpandedTemplate)} parameter.");

        if (string.IsNullOrEmpty(Title))
            Title = "Details";

        base.OnParametersSet();
    }

    protected override void CellContent(RenderTreeBuilder builder, TGridItem item)
    {
        var key = ItemKey(item);
        var isExpanded = _stateManager.IsExpanded(key);
        var hasAnyExpanded = _stateManager.HasExpandedRows;

        int seq = 0;

        // Wrapper div with state classes
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", BuildCellClass(isExpanded, hasAnyExpanded));

        if (isExpanded)
        {
            RenderExpandedMode(builder, ref seq, item, key);
        }
        else
        {
            RenderCollapsedMode(builder, ref seq, item, key, hasAnyExpanded);
        }

        builder.CloseElement();
    }

    #endregion

    #region Rendering

    private void RenderCollapsedMode(RenderTreeBuilder builder, ref int seq, TGridItem item, TKey key, bool hasAnyExpanded)
    {
        var displayContext = new LogDetailDisplayContext<TGridItem>
        {
            Item = item,
            IsAnyRowExpanded = hasAnyExpanded,
            ExpandAsync = () => ExpandRowAsync(item, key)
        };

        if (CollapsedTemplate != null)
        {
            builder.AddContent(seq++, CollapsedTemplate(displayContext));
        }
        else if (TriggerMode == LogDetailTriggerMode.Button)
        {
            RenderDefaultExpandButton(builder, ref seq, displayContext, key);
        }
        else if (TriggerMode == LogDetailTriggerMode.RowClick)
        {
            var detailId = $"log-detail-{key}";
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "log-detail-click-indicator");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "tabindex", "0");
            builder.AddAttribute(seq++, "aria-expanded", "false");
            builder.AddAttribute(seq++, "aria-controls", detailId);
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await displayContext.ExpandAsync()));
            builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, async e =>
            {
                if (e.Key is "Enter" or " ")
                    await displayContext.ExpandAsync();
            }));
            builder.AddAttribute(seq++, "title", "Click to expand");
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", ExpandIcon ?? "bi bi-chevron-down");
            builder.AddAttribute(seq++, "aria-hidden", "true");
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private void RenderDefaultExpandButton(RenderTreeBuilder builder, ref int seq, LogDetailDisplayContext<TGridItem> context, TKey key)
    {
        var detailId = $"log-detail-{key}";
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", ButtonClass);
        builder.AddAttribute(seq++, "aria-expanded", "false");
        builder.AddAttribute(seq++, "aria-controls", detailId);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await context.ExpandAsync()));
        builder.AddAttribute(seq++, "title", "Expand details");

        if (!string.IsNullOrEmpty(ExpandIcon))
        {
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", ExpandIcon);
            builder.AddAttribute(seq++, "aria-hidden", "true");
            builder.CloseElement();
        }

        if (!string.IsNullOrEmpty(ExpandButtonText))
        {
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, ExpandButtonText);
            builder.CloseElement();
        }

        builder.CloseElement();
    }

    private void RenderExpandedMode(RenderTreeBuilder builder, ref int seq, TGridItem item, TKey key)
    {
        // Create context for expanded template
        var context = new LogDetailContext<TGridItem>
        {
            Item = item,
            IsExpanded = true,
            CollapseAsync = () => CollapseRowAsync(item, key)
        };

        var detailId = $"log-detail-{key}";

        // Expanded content container
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "id", detailId);
        builder.AddAttribute(seq++, "class", "log-detail-expanded");
        builder.AddAttribute(seq++, "role", "region");
        builder.AddAttribute(seq++, "aria-live", "polite");

        // Provide cascading context
        builder.OpenComponent<CascadingValue<LogDetailContext<TGridItem>>>(seq++);
        builder.AddComponentParameter(seq++, "Value", context);
        builder.AddComponentParameter(seq++, "ChildContent", ExpandedTemplate!(context));
        builder.CloseComponent();

        // Default collapse button
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", $"{ButtonClass} log-detail-collapse-btn");
        builder.AddAttribute(seq++, "aria-expanded", "true");
        builder.AddAttribute(seq++, "aria-controls", detailId);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async _ => await context.CollapseAsync()));
        builder.AddAttribute(seq++, "title", "Collapse details");

        if (!string.IsNullOrEmpty(CollapseIcon))
        {
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", CollapseIcon);
            builder.AddAttribute(seq++, "aria-hidden", "true");
            builder.CloseElement();
        }

        if (!string.IsNullOrEmpty(CollapseButtonText))
        {
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, CollapseButtonText);
            builder.CloseElement();
        }

        builder.CloseElement(); // button
        builder.CloseElement(); // div.log-detail-expanded
    }

    private string BuildCellClass(bool isExpanded, bool hasAnyExpanded)
    {
        var classes = new List<string> { "log-detail-cell" };

        if (isExpanded)
        {
            classes.Add("log-detail-active");
        }
        else if (hasAnyExpanded && DimCollapsedRows)
        {
            classes.Add("log-detail-dimmed");
        }

        return string.Join(" ", classes);
    }

    #endregion

    #region Expansion Management

    private async Task ExpandRowAsync(TGridItem item, TKey key)
    {
        // Fire before-expand event
        var beforeExpandArgs = new LogDetailBeforeExpandEventArgs<TGridItem> { Item = item };
        await OnBeforeExpand.InvokeAsync(beforeExpandArgs);

        if (beforeExpandArgs.Cancel)
            return;

        // Expand the row
        var wasExpanded = await _stateManager.ExpandAsync(key);

        if (wasExpanded)
        {
            // Fire expanded event
            await OnExpanded.InvokeAsync(new LogDetailExpandedEventArgs<TGridItem>
            {
                Item = item,
                Key = key
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CollapseRowAsync(TGridItem item, TKey key)
    {
        var wasCollapsed = await _stateManager.CollapseAsync(key);

        if (wasCollapsed)
        {
            // Fire collapsed event
            await OnCollapsed.InvokeAsync(new LogDetailCollapsedEventArgs<TGridItem>
            {
                Item = item,
                Key = key
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Programmatically collapse all expanded rows.
    /// </summary>
    public async Task CollapseAllAsync()
    {
        await _stateManager.CollapseAllAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Programmatically toggle a row's expansion state.
    /// </summary>
    public async Task ToggleRowAsync(TGridItem item)
    {
        var key = ItemKey(item);
        var isNowExpanded = await _stateManager.ToggleAsync(key);

        if (isNowExpanded)
        {
            await OnExpanded.InvokeAsync(new LogDetailExpandedEventArgs<TGridItem>
            {
                Item = item,
                Key = key
            });
        }
        else
        {
            await OnCollapsed.InvokeAsync(new LogDetailCollapsedEventArgs<TGridItem>
            {
                Item = item,
                Key = key
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region IDisposable

    public void Dispose()
    {
        if (_disposed) return;
        _stateManager.Dispose();
        _disposed = true;
    }

    #endregion
}
