namespace QuickGridTest01.RowColumn.Core;

/// <summary>
/// Creates spacer rows for expanded overlay positioning.
/// Spacer rows push real data rows down so they remain visible below the overlay card.
/// </summary>
public static class SpacerRowFactory
{
    /// <summary>
    /// Encoding multiplier for parent row ID in spacer IDs.
    /// Spacer ID = -(parentId * Multiplier + offset)
    /// </summary>
    private const int Multiplier = 1000;

    /// <summary>
    /// Creates spacer rows to insert after an expanded row.
    /// </summary>
    /// <typeparam name="T">Entity type implementing IRowIdentifiable</typeparam>
    /// <param name="parentRowId">The Id of the expanded row</param>
    /// <param name="count">Number of spacers (ExpandedRowSpan)</param>
    /// <returns>Collection of spacer rows with negative Ids</returns>
    public static IEnumerable<T> CreateSpacers<T>(int parentRowId, int count)
        where T : IRowIdentifiable, new()
    {
        for (int i = 1; i <= count; i++)
        {
            yield return new T { Id = EncodeSpacerId(parentRowId, i) };
        }
    }

    /// <summary>
    /// Encodes a spacer ID from parent row ID and offset.
    /// </summary>
    /// <param name="parentRowId">The ID of the parent (expanded) row</param>
    /// <param name="offset">The spacer offset (1-based)</param>
    /// <returns>A negative ID uniquely identifying this spacer</returns>
    public static int EncodeSpacerId(int parentRowId, int offset)
        => -(parentRowId * Multiplier + offset);

    /// <summary>
    /// Extracts the parent row Id from a spacer's Id.
    /// </summary>
    /// <param name="spacerId">The negative spacer ID</param>
    /// <returns>The parent row's positive ID</returns>
    public static int GetParentRowId(int spacerId)
        => Math.Abs(spacerId) / Multiplier;

    /// <summary>
    /// Extracts the offset from a spacer's Id.
    /// </summary>
    /// <param name="spacerId">The negative spacer ID</param>
    /// <returns>The spacer offset (1-based)</returns>
    public static int GetSpacerOffset(int spacerId)
        => Math.Abs(spacerId) % Multiplier;

    /// <summary>
    /// Checks if an ID represents a spacer row.
    /// </summary>
    /// <param name="id">The row ID to check</param>
    /// <returns>True if the ID is negative (spacer row)</returns>
    public static bool IsSpacer(int id) => id < 0;

    /// <summary>
    /// Checks if an item is a spacer row.
    /// </summary>
    /// <typeparam name="T">Entity type implementing IRowIdentifiable</typeparam>
    /// <param name="item">The item to check</param>
    /// <returns>True if the item is a spacer row</returns>
    public static bool IsSpacer<T>(T item) where T : IRowIdentifiable
        => item.IsSpacer;
}
