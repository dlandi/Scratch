/* RowColumn Scoped Styles - Self-contained styles for the RowColumn component */

/* Cell wrapper */
.row-column-cell {
    position: relative;
}

/* Row expanded state */
.row-column-cell.row-expanded {
    z-index: 11;
}

/* Row dimmed state (when another row is expanded) */
.row-column-cell.row-dimmed {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity var(--duration-normal, 200ms) var(--ease-in-out, ease-in-out);
}

/* Overlay container for expanded content - positioned below the trigger row */
.row-overlay {
    position: absolute;
    top: 100%; /* Position below the current row */
    left: -100vw; /* Extend to full viewport width */
    right: -100vw;
    margin-left: calc(-1 * var(--cell-padding-x, 12px)); /* Align with cell edge */
    z-index: 100;
    
    background: var(--color-canvas-subtle, #f6f8fa);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: 0;
    box-shadow: var(--shadow-md, 0 3px 6px rgba(140, 149, 159, 0.15));
    
    /* Height is set via inline style based on ExpandedRowSpan × RowHeight */
    overflow: hidden;
    
    /* Ensure content fills the overlay */
    display: flex;
    align-items: stretch;
}

/* Content wrapper inside the overlay */
.row-overlay > * {
    width: 100%;
    padding: var(--space-16, 16px) var(--space-24, 24px);
}

/* Row click indicator */
.row-click-indicator {
    cursor: pointer;
    padding: var(--space-4, 4px) var(--space-8, 8px);
    border-radius: var(--radius-sm, 4px);
    transition: background-color var(--duration-fast, 100ms) var(--ease-in-out, ease-in-out);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.row-click-indicator:hover {
    background-color: var(--color-neutral-muted, rgba(175, 184, 193, 0.2));
}

.row-click-indicator i {
    font-size: var(--font-size-sm, 14px);
    color: var(--color-text-secondary, #656d76);
}

/* Button styling */
.row-column-cell button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4, 4px);
}

.row-column-cell button i {
    font-size: var(--font-size-sm, 14px);
}
