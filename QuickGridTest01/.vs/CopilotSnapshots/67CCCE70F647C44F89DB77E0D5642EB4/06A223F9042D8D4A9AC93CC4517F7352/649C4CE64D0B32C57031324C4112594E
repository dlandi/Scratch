/* RowColumn Scoped Styles - Self-contained styles for the RowColumn component */

/* Cell wrapper */
.row-column-cell {
    position: relative;
}

/* Row expanded state */
.row-column-cell.row-expanded {
    z-index: 11;
}

/* Row dimmed state (when another row is expanded) */
.row-column-cell.row-dimmed {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity var(--duration-normal, 200ms) var(--ease-in-out, ease-in-out);
}

/* Overlay container for expanded content */
.row-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    min-height: 100%;
    z-index: 10;
    
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border-emphasis, #d0d7de);
    border-radius: var(--card-radius, 6px);
    box-shadow: var(--shadow-lg, 0 8px 24px rgba(140, 149, 159, 0.2));
    padding: var(--space-16, 16px);
}

/* Row click indicator */
.row-click-indicator {
    cursor: pointer;
    padding: var(--space-4, 4px) var(--space-8, 8px);
    border-radius: var(--radius-sm, 4px);
    transition: background-color var(--duration-fast, 100ms) var(--ease-in-out, ease-in-out);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.row-click-indicator:hover {
    background-color: var(--color-neutral-muted, rgba(175, 184, 193, 0.2));
}

.row-click-indicator i {
    font-size: var(--font-size-sm, 14px);
    color: var(--color-text-secondary, #656d76);
}
