@page "/row-column-demo"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.RowColumn
@using QuickGridTest01.RowColumn.Core
@using QuickGridTest01.RowColumn.Events
@using QuickGridTest01.RowColumn.Components

<PageTitle>RowColumn Demo</PageTitle>

<div class="qg-container">
    <header class="qg-page-header">
        <h1 class="qg-page-title">RowColumn Component</h1>
        <p class="qg-page-subtitle">
            A base class for row-spanning QuickGrid columns. When expanded, displays an overlay card below the trigger row 
            that spans a configurable number of row heights.
        </p>
    </header>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Basic RowColumn Demo</h2>
            <p class="qg-section-description">
                Click "Edit" to expand a row. The card spans <strong>@_rowSpan</strong> row heights below the trigger row.
            </p>
        </div>

        <div class="controls-bar">
            <label>
                Row Span:
                <select @bind="_rowSpan" @bind:after="StateHasChanged">
                    <option value="2">2 rows</option>
                    <option value="3">3 rows</option>
                    <option value="4">4 rows</option>
                    <option value="5">5 rows</option>
                </select>
            </label>
            <label>
                Row Height:
                <select @bind="_rowHeight" @bind:after="StateHasChanged">
                    <option value="40">40px</option>
                    <option value="48">48px (default)</option>
                    <option value="56">56px</option>
                </select>
            </label>
            <label>
                Concurrent Behavior:
                <select @bind="_concurrentBehavior" @bind:after="StateHasChanged">
                    <option value="@ConcurrentExpandBehavior.Block">Block</option>
                    <option value="@ConcurrentExpandBehavior.CollapseCurrent">Collapse Current</option>
                    <option value="@ConcurrentExpandBehavior.AllowMultiple">Allow Multiple</option>
                </select>
            </label>
            <label>
                <input type="checkbox" @bind="_dimInactiveRows" @bind:after="StateHasChanged" />
                Dim Inactive Rows
            </label>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_employees" Class="qg-grid qg-grid-striped qg-row-grid">
                <PropertyColumn Property="@(e => e.Id)" Title="ID" />
                <PropertyColumn Property="@(e => e.FirstName)" Title="First Name" />
                <PropertyColumn Property="@(e => e.LastName)" Title="Last Name" />
                <PropertyColumn Property="@(e => e.Email)" Title="Email" />
                <PropertyColumn Property="@(e => e.Department)" Title="Department" />
                
                <RowColumn TGridItem="Employee"
                           Title="Actions"
                           ExpandedRowSpan="@_rowSpan"
                           RowHeight="@_rowHeight"
                           ConcurrentBehavior="@_concurrentBehavior"
                           DimInactiveRows="@_dimInactiveRows"
                           ExpandButtonText="Edit"
                           ExpandButtonIcon="bi bi-pencil"
                           OnExpanded="@OnRowExpanded"
                           OnCollapsed="@OnRowCollapsed">
                    <ExpandedTemplate Context="ctx">
                        <RowCard Title="@($"Edit Employee: {ctx.Item.FirstName} {ctx.Item.LastName}")" 
                                 ShowCloseButton="true" 
                                 OnClose="@ctx.CollapseAsync">
                            <ChildContent>
                                <div class="expanded-content">
                                    <div class="field-row">
                                        <div class="field">
                                            <label>First Name</label>
                                            <input type="text" value="@ctx.Item.FirstName" readonly class="qg-input" />
                                        </div>
                                        <div class="field">
                                            <label>Last Name</label>
                                            <input type="text" value="@ctx.Item.LastName" readonly class="qg-input" />
                                        </div>
                                    </div>
                                    <div class="field-row">
                                        <div class="field">
                                            <label>Email</label>
                                            <input type="email" value="@ctx.Item.Email" readonly class="qg-input" />
                                        </div>
                                        <div class="field">
                                            <label>Department</label>
                                            <input type="text" value="@ctx.Item.Department" readonly class="qg-input" />
                                        </div>
                                    </div>
                                    <div class="field-row">
                                        <div class="field">
                                            <label>Salary</label>
                                            <input type="text" value="@ctx.Item.Salary.ToString("C0")" readonly class="qg-input" />
                                        </div>
                                        <div class="field">
                                            <label>Hire Date</label>
                                            <input type="text" value="@ctx.Item.HireDate.ToShortDateString()" readonly class="qg-input" />
                                        </div>
                                    </div>
                                </div>
                            </ChildContent>
                            <FooterContent>
                                <button class="qg-btn qg-btn-primary" @onclick="@ctx.CollapseAsync">
                                    <i class="bi bi-check"></i> Done
                                </button>
                                <button class="qg-btn qg-btn-secondary" @onclick="@ctx.CollapseAsync">
                                    <i class="bi bi-x"></i> Cancel
                                </button>
                            </FooterContent>
                        </RowCard>
                    </ExpandedTemplate>
                </RowColumn>
            </QuickGrid>
        </div>

        @if (_eventLog.Any())
        {
            <div class="event-log">
                <h5>Event Log</h5>
                <div class="log-entries">
                    @foreach (var entry in _eventLog.TakeLast(5).Reverse())
                    {
                        <div class="log-entry">@entry</div>
                    }
                </div>
            </div>
        }
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Configuration Options</h2>
        </div>
        
        <div class="options-grid">
            <div class="option-card">
                <h4>ExpandedRowSpan</h4>
                <p>Number of row heights the expanded card should occupy. Important for virtualization compatibility where all rows must have uniform height.</p>
                <code>ExpandedRowSpan="3"</code>
            </div>
            
            <div class="option-card">
                <h4>RowHeight</h4>
                <p>Height of each row in pixels. Used to calculate total card height: <code>ExpandedRowSpan × RowHeight</code>.</p>
                <code>RowHeight="48"</code>
            </div>
            
            <div class="option-card">
                <h4>ConcurrentBehavior</h4>
                <p>Controls what happens when expanding a row while another is open: Block, CollapseCurrent, or AllowMultiple.</p>
                <code>ConcurrentBehavior="Block"</code>
            </div>
            
            <div class="option-card">
                <h4>DimInactiveRows</h4>
                <p>When true, non-expanded rows are visually dimmed to focus attention on the expanded row.</p>
                <code>DimInactiveRows="true"</code>
            </div>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Key Features</h2>
        </div>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-title">Virtualization Compatible</div>
                <div class="feature-desc">Fixed row span ensures consistent heights for virtualized grids</div>
            </div>
            <div class="feature-card">
                <div class="feature-title">Self-Contained CSS</div>
                <div class="feature-desc">Scoped styles don't leak outside the component</div>
            </div>
            <div class="feature-card">
                <div class="feature-title">Cascading Context</div>
                <div class="feature-desc">RowExpandedContext cascaded to child components</div>
            </div>
            <div class="feature-card">
                <div class="feature-title">Extensible Base</div>
                <div class="feature-desc">Virtual hooks for derived classes like FormRowColumn</div>
            </div>
        </div>
    </section>
</div>

@code {
    private IQueryable<Employee> _employees = default!;
    private List<string> _eventLog = new();
    
    // Configuration
    private int _rowSpan = 3;
    private int _rowHeight = 48;
    private ConcurrentExpandBehavior _concurrentBehavior = ConcurrentExpandBehavior.Block;
    private bool _dimInactiveRows = true;

    protected override void OnInitialized()
    {
        InitializeData();
    }

    private void InitializeData()
    {
        var employeeList = new List<Employee>
        {
            new() { Id = 1, FirstName = "Alice", LastName = "Johnson", Email = "alice@example.com", Department = "Engineering", Salary = 95000, HireDate = new DateTime(2020, 3, 15) },
            new() { Id = 2, FirstName = "Bob", LastName = "Smith", Email = "bob@example.com", Department = "Marketing", Salary = 78000, HireDate = new DateTime(2021, 7, 22) },
            new() { Id = 3, FirstName = "Carol", LastName = "Williams", Email = "carol@example.com", Department = "Sales", Salary = 82000, HireDate = new DateTime(2019, 1, 10) },
            new() { Id = 4, FirstName = "David", LastName = "Brown", Email = "david@example.com", Department = "Engineering", Salary = 103000, HireDate = new DateTime(2018, 5, 20) },
            new() { Id = 5, FirstName = "Eva", LastName = "Davis", Email = "eva@example.com", Department = "HR", Salary = 72000, HireDate = new DateTime(2022, 4, 5) },
            new() { Id = 6, FirstName = "Frank", LastName = "Miller", Email = "frank@example.com", Department = "Engineering", Salary = 98000, HireDate = new DateTime(2020, 11, 30) },
            new() { Id = 7, FirstName = "Grace", LastName = "Wilson", Email = "grace@example.com", Department = "Marketing", Salary = 85000, HireDate = new DateTime(2021, 2, 14) },
            new() { Id = 8, FirstName = "Henry", LastName = "Moore", Email = "henry@example.com", Department = "Sales", Salary = 76000, HireDate = new DateTime(2022, 8, 1) },
            new() { Id = 9, FirstName = "Iris", LastName = "Taylor", Email = "iris@example.com", Department = "Engineering", Salary = 110000, HireDate = new DateTime(2017, 6, 12) },
            new() { Id = 10, FirstName = "Jack", LastName = "Anderson", Email = "jack@example.com", Department = "HR", Salary = 68000, HireDate = new DateTime(2023, 1, 8) },
        };
        _employees = employeeList.AsQueryable();
    }

    private void OnRowExpanded(RowExpandedEventArgs<Employee> args)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        _eventLog.Add($"[{timestamp}] Expanded: {args.Item.FirstName} {args.Item.LastName}");
        StateHasChanged();
    }

    private void OnRowCollapsed(RowCollapsedEventArgs<Employee> args)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        _eventLog.Add($"[{timestamp}] Collapsed: {args.Item.FirstName} {args.Item.LastName}");
        StateHasChanged();
    }

    public class Employee
    {
        public int Id { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public int Salary { get; set; }
        public DateTime HireDate { get; set; }
    }
}
