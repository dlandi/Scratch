/* RowColumnDemo Page Styles */

.controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16, 16px);
    align-items: center;
    margin-bottom: var(--space-16, 16px);
    padding: var(--space-12, 12px) var(--space-16, 16px);
    background: var(--color-canvas-subtle, #f6f8fa);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-md, 6px);
}

.controls-bar label {
    display: flex;
    align-items: center;
    gap: var(--space-8, 8px);
    font-size: var(--font-size-sm, 14px);
    color: var(--color-text-secondary, #656d76);
}

.controls-bar select {
    padding: var(--space-4, 4px) var(--space-8, 8px);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-sm, 4px);
    background: var(--color-surface, #ffffff);
    font-size: var(--font-size-sm, 14px);
}

.controls-bar input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
}

/* Expanded content styling */
.expanded-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-12, 12px);
}

.field-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-12, 12px);
}

.field {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 4px);
}

.field label {
    font-size: var(--font-size-sm, 14px);
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-secondary, #656d76);
}

.field input.qg-input {
    padding: var(--space-8, 8px) var(--space-12, 12px);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-sm, 4px);
    background: var(--color-surface, #ffffff);
    font-size: var(--font-size-base, 14px);
    color: var(--color-text-primary, #1f2328);
}

.field input.qg-input:read-only {
    background: var(--color-canvas-subtle, #f6f8fa);
    color: var(--color-text-secondary, #656d76);
}

/* Event log */
.event-log {
    margin-top: var(--space-16, 16px);
    padding: var(--space-12, 12px) var(--space-16, 16px);
    background: var(--color-canvas-subtle, #f6f8fa);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-md, 6px);
}

.event-log h5 {
    margin: 0 0 var(--space-8, 8px) 0;
    font-size: var(--font-size-sm, 14px);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #1f2328);
}

.log-entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 4px);
}

.log-entry {
    font-size: var(--font-size-sm, 14px);
    font-family: var(--font-mono, monospace);
    color: var(--color-text-secondary, #656d76);
    padding: var(--space-4, 4px) var(--space-8, 8px);
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-sm, 4px);
}

/* Options grid */
.options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-16, 16px);
}

.option-card {
    padding: var(--space-16, 16px);
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-md, 6px);
}

.option-card h4 {
    margin: 0 0 var(--space-8, 8px) 0;
    font-size: var(--font-size-base, 14px);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #1f2328);
}

.option-card p {
    margin: 0 0 var(--space-8, 8px) 0;
    font-size: var(--font-size-sm, 14px);
    color: var(--color-text-secondary, #656d76);
    line-height: 1.5;
}

.option-card code {
    display: inline-block;
    padding: var(--space-2, 2px) var(--space-6, 6px);
    background: var(--color-neutral-muted, rgba(175, 184, 193, 0.2));
    border-radius: var(--radius-sm, 4px);
    font-size: var(--font-size-sm, 14px);
    font-family: var(--font-mono, monospace);
    color: var(--color-text-primary, #1f2328);
}

/* Features grid */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-16, 16px);
}

.feature-card {
    padding: var(--space-16, 16px);
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border-default, #d0d7de);
    border-radius: var(--radius-md, 6px);
    text-align: center;
}

.feature-title {
    font-size: var(--font-size-base, 14px);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #1f2328);
    margin-bottom: var(--space-8, 8px);
}

.feature-desc {
    font-size: var(--font-size-sm, 14px);
    color: var(--color-text-secondary, #656d76);
    line-height: 1.4;
}
