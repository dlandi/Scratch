.filter-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.feature-matrix-grid .qg-grid th,
.feature-matrix-grid .qg-grid td {
    text-align: center;
    padding: 0.5rem 0.75rem;
}

.feature-matrix-grid .qg-grid th:first-child,
.feature-matrix-grid .qg-grid td:first-child,
.feature-matrix-grid .qg-grid th:nth-child(2),
.feature-matrix-grid .qg-grid td:nth-child(2) {
    text-align: left;
}

/* Make the icon columns narrower */
.feature-matrix-grid .qg-grid th:nth-child(n+3),
.feature-matrix-grid .qg-grid td:nth-child(n+3) {
    min-width: 70px;
    max-width: 90px;
}

.coverage-bar {
    width: 100%;
    height: 8px;
    background: var(--qg-neutral-200, #e5e7eb);
    border-radius: 4px;
    overflow: hidden;
    min-width: 100px;
}

.coverage-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--qg-primary, #3b82f6), var(--qg-primary-600, #2563eb));
    border-radius: 4px;
    transition: width 0.3s ease;
}

.legend-container {
    display: flex;
    gap: 2rem;
    padding: 1rem;
    background: var(--qg-neutral-50, #f9fafb);
    border-radius: 0.5rem;
    border: 1px solid var(--qg-neutral-200, #e5e7eb);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--qg-neutral-600, #4b5563);
}

.legend-item i {
    font-size: 1.25rem;
}

/* Category grouping styles */
.feature-matrix-grid .qg-grid tbody tr td:first-child {
    font-weight: 500;
    color: var(--qg-neutral-500, #6b7280);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* Hover effect for feature rows */
.feature-matrix-grid .qg-grid tbody tr:hover {
    background-color: var(--qg-neutral-50, #f9fafb);
}

/* Alternating row colors per category */
.feature-matrix-grid .qg-grid tbody tr:nth-child(odd) {
    background-color: var(--qg-white, #ffffff);
}

.feature-matrix-grid .qg-grid tbody tr:nth-child(even) {
    background-color: var(--qg-neutral-25, #fcfcfd);
}

/* Icon column container styling */
.feature-matrix-grid .icon-column-container {
    display: flex;
    justify-content: center;
    align-items: center;
}

.feature-matrix-grid .icon-column-container i {
    margin-right: 0 !important;
}

/* Section spacing */
.qg-section + .qg-section {
    margin-top: 2rem;
}

/* Responsive adjustments */
@media (max-width: 1200px) {
    .feature-matrix-grid {
        overflow-x: auto;
    }
    
    .feature-matrix-grid .qg-grid {
        min-width: 1000px;
    }
}

@media (max-width: 768px) {
    .filter-controls {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
    
    .legend-container {
        flex-direction: column;
        gap: 0.75rem;
    }
}
