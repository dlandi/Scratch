/* Composable Grid Filter Toolbar - Compact Responsive Layout */
/* Uses ::deep to penetrate into dynamically rendered content from RenderFilterInput */

.composable-grid-filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.75rem;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    margin-bottom: 0.5rem;
    align-items: flex-end;
}

/* Each filter item - compact inline layout with max-width for horizontal fitting */
::deep .filter-toolbar-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    flex: 0 1 auto;
    max-width: 180px;
}

::deep .qg-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    margin-bottom: 0;
    white-space: nowrap;
}

/* Controls row - inline with compact sizing */
::deep .filter-toolbar-controls {
    display: flex;
    gap: 0.25rem;
    align-items: center;
}

/* Compact operator dropdown */
::deep .filter-operator {
    flex: 0 0 auto;
    width: 4.5rem;
    padding: 0.25rem 0.25rem;
    font-size: 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    background: white;
}

/* Value input - flexible sizing based on type */
::deep .filter-value {
    flex: 1 1 auto;
    min-width: 50px;
    width: 90px;
    padding: 0.25rem 0.375rem;
    font-size: 0.8rem;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
}

/* Numeric inputs can be narrower */
::deep input[type="number"].filter-value {
    width: 70px;
}

/* Date inputs */
::deep input[type="date"].filter-value {
    width: 110px;
}

/* Checkbox for boolean filters */
::deep .filter-checkbox {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
}

/* Clear button - compact icon only */
::deep .btn-filter-clear {
    flex: 0 0 auto;
    padding: 0.125rem;
    background: transparent;
    border: none;
    color: #dc3545;
    cursor: pointer;
    border-radius: 0.25rem;
    line-height: 1;
    font-size: 0.875rem;
}

::deep .btn-filter-clear:hover {
    background: rgba(220, 53, 69, 0.1);
}

/* Actions container - pushed to end */
.filter-toolbar-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Filter count display */
.filter-count {
    font-size: 0.75rem;
    color: #6c757d;
    white-space: nowrap;
}

/* Clear All button */
.btn-clear-all-filters {
    padding: 0.25rem 0.5rem;
    background: #6c757d;
    color: white;
    border: none;
    border-radius: 0.25rem;
    font-size: 0.7rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
}

.btn-clear-all-filters:hover {
    background: #5c636a;
}

/* Responsive adjustments */
@media (max-width: 480px) {
    .composable-grid-filter-toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    ::deep .filter-toolbar-item {
        flex: 1 1 100%;
        max-width: none;
    }
    
    ::deep .filter-value {
        width: auto;
        flex: 1;
    }
    
    .filter-toolbar-actions {
        margin-left: 0;
        justify-content: flex-end;
    }
}
