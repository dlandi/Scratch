## 8. Usage Example

```razor
<ComposableGrid TGridItem="Employee" Items="@employees" RowKey="e => e.Id">
    <ComposableColumn TGridItem="Employee" TValue="string"
                      Property="@(e => e.Name)" Title="Name" />
    <ComposableColumn TGridItem="Employee" TValue="string"
                      Property="@(e => e.Email)" Title="Email" />
    
    <ComposableColumn TGridItem="Employee" TValue="int"
                      Property="@(e => e.Id)"
                      Title="Actions"
                      FeatureCollection="@_formFeatures" />
</ComposableGrid>

@code {
    private IColumnFeature<Employee>[] _formFeatures = [
        new FormRowFeature<Employee>
        {
            TriggerMode = RowTriggerMode.Button,
            EditButtonText = "Edit",
            UseDataAnnotations = true,
            OnSaveAsync = async emp => 
            {
                await _service.UpdateAsync(emp);
                return (true, null);
            },
            FormTemplate = context => @<FormCard Title="Edit Employee">
                <FormSection>
                    <FormField Property="@(e => e.FirstName)" />
                    <FormField Property="@(e => e.LastName)" />
                </FormSection>
                <FormSection Title="Contact">
                    <FormField Property="@(e => e.Email)" />
                    <FormField Property="@(e => e.Phone)" />
                </FormSection>
                <FormActions />
            </FormCard>
        }
    ];
}
```

