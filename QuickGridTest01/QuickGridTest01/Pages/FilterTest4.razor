@page "/filter-test-4"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.ComposableColumns.Core
@using QuickGridTest01.ComposableColumns.Features.Filtering

<PageTitle>Filter Test 4 - Grid-Integrated Filter</PageTitle>

<h1>Filter Test 4 - Grid-Integrated Filter</h1>
<p>This page demonstrates the <strong>integrated filtering</strong> where:</p>
<ul>
    <li>Columns declare they want filtering via <code>FilterFeature</code></li>
    <li><code>ComposableGrid</code> auto-renders the filter toolbar</li>
    <li>Grid automatically applies all active filters to the data</li>
    <li>Shows filtered count when filters are active</li>
    <li>Supports <strong>String</strong>, <strong>Numeric</strong>, <strong>DateTime</strong>, and <strong>Boolean</strong> types</li>
</ul>

<div class="grid-section">
    <ComposableGrid TGridItem="TestItem" Items="@_items" RowKey="x => x.Id" Class="qg-grid">
        <ComposableColumn TGridItem="TestItem" TValue="int" 
                          Property="x => x.Id" 
                          Title="ID" />
        <ComposableColumn TGridItem="TestItem" TValue="string" 
                          Property="x => x.Name" 
                          Title="Name"
                          FeatureCollection="@_nameFeatures" />
        <ComposableColumn TGridItem="TestItem" TValue="decimal" 
                          Property="x => x.Value" 
                          Title="Value" 
                          Format="C2"
                          FeatureCollection="@_valueFeatures" />
        <ComposableColumn TGridItem="TestItem" TValue="int" 
                          Property="x => x.Stock" 
                          Title="Stock"
                          FeatureCollection="@_stockFeatures" />
        <ComposableColumn TGridItem="TestItem" TValue="DateTime" 
                          Property="x => x.Created" 
                          Title="Created"
                          Format="yyyy-MM-dd"
                          FeatureCollection="@_dateFeatures" />
        <ComposableColumn TGridItem="TestItem" TValue="bool" 
                          Property="x => x.IsActive" 
                          Title="Active"
                          FeatureCollection="@_boolFeatures" />
    </ComposableGrid>
</div>

<p style="margin-top: 1rem;">Total source items: @_items.Count()</p>

@code {
    private IQueryable<TestItem> _items = Array.Empty<TestItem>().AsQueryable();
    
    // Feature collections - only need to add FilterFeature to enable filtering
    private IColumnFeature<TestItem>[] _nameFeatures = [new FilterFeature<TestItem, string>()];
    private IColumnFeature<TestItem>[] _valueFeatures = [new FilterFeature<TestItem, decimal>()];
    private IColumnFeature<TestItem>[] _stockFeatures = [new FilterFeature<TestItem, int>()];
    private IColumnFeature<TestItem>[] _dateFeatures = [new FilterFeature<TestItem, DateTime>()];
    private IColumnFeature<TestItem>[] _boolFeatures = [new FilterFeature<TestItem, bool>()];

    protected override void OnInitialized()
    {
        _items = new List<TestItem>
        {
            new(1, "Apple", 1.50m, 100, DateTime.Now.AddDays(-5), true),
            new(2, "Banana", 0.75m, 150, DateTime.Now.AddDays(-3), true),
            new(3, "Cherry", 2.00m, 50, DateTime.Now.AddDays(-10), false),
            new(4, "Date", 3.00m, 25, DateTime.Now.AddDays(-1), true),
            new(5, "Elderberry", 4.50m, 10, DateTime.Now.AddDays(-15), false),
            new(6, "Fig", 2.25m, 75, DateTime.Now.AddDays(-7), true),
            new(7, "Grape", 1.25m, 200, DateTime.Now.AddDays(-2), true),
            new(8, "Honeydew", 3.50m, 30, DateTime.Now.AddDays(-20), false),
        }.AsQueryable();
    }

    public record TestItem(int Id, string Name, decimal Value, int Stock, DateTime Created, bool IsActive);
}
