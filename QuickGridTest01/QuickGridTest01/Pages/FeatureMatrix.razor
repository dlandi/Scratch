@page "/feature-matrix"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.CustomColumns

<PageTitle>Custom Columns - Feature Matrix</PageTitle>

<div class="qg-container">
    <header class="qg-page-header">
        <h1 class="qg-page-title">Custom Columns Feature Matrix</h1>
        <p class="qg-page-subtitle">
            A comprehensive comparison of all custom QuickGrid column implementations, 
            rendered using our own custom columns.
        </p>
    </header>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Column Overview</h2>
            <p class="qg-section-description">
                This application includes 10 custom QuickGrid columns, each designed for specific use cases.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_columnOverviews" Class="qg-grid">
                <PropertyColumn Property="@(c => c.Name)" Title="Column" Sortable="true" />
                <PropertyColumn Property="@(c => c.Purpose)" Title="Purpose" />
                <PropertyColumn Property="@(c => c.Namespace)" Title="Namespace" />
                <PropertyColumn Property="@(c => c.UseCase)" Title="Best For" />
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Feature Comparison</h2>
            <div class="filter-controls">
                <label class="qg-label">Filter by Category:</label>
                <select class="qg-select" @bind="_selectedCategory">
                    <option value="">All Categories</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
        </div>

        <div class="qg-grid-container feature-matrix-wrapper">
            <div class="feature-matrix-scroll">
                <QuickGrid Items="@FilteredFeatures" Class="qg-grid feature-matrix-grid">
                    <PropertyColumn Property="@(f => f.Category)" Title="Category" Sortable="true" Class="sticky-col sticky-col-1" />
                    <PropertyColumn Property="@(f => f.FeatureName)" Title="Feature" Sortable="true" Class="sticky-col sticky-col-2" />
                    
                    <TemplateColumn Title="FormRow" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.FormRow))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="FormRowColumn - Inline form editing with full row overlay">
                                <span class="header-abbrev">FR</span>
                                <span class="header-full">FormRow</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.FormRow))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Editable" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.Editable))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="EditableColumn - Inline cell editing with validation">
                                <span class="header-abbrev">ED</span>
                                <span class="header-full">Editable</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.Editable))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="MultiState" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.MultiState))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="MultiStateColumn - Cell editing with state machine (Reading/Editing/Loading)">
                                <span class="header-abbrev">MS</span>
                                <span class="header-full">MultiState</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.MultiState))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Filterable" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.Filterable))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="FilterableColumn - Column with built-in filtering UI">
                                <span class="header-abbrev">FI</span>
                                <span class="header-full">Filterable</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.Filterable))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="CondStyle" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.ConditionalStyle))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="ConditionalStyleColumn - Dynamic styling based on value rules">
                                <span class="header-abbrev">CS</span>
                                <span class="header-full">CondStyle</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.ConditionalStyle))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Formatted" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.FormattedValue))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="FormattedValueColumn - Value formatting with culture support">
                                <span class="header-abbrev">FV</span>
                                <span class="header-full">Formatted</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.FormattedValue))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Icon" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.Icon))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="IconColumn - Icon display with value mapping">
                                <span class="header-abbrev">IC</span>
                                <span class="header-full">Icon</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.Icon))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Optimized" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.Optimized))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="OptimizedColumn - Performance-optimized rendering">
                                <span class="header-abbrev">OP</span>
                                <span class="header-full">Optimized</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.Optimized))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Virtual" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.Virtual))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="VirtualColumn - Optimized for virtual scrolling">
                                <span class="header-abbrev">VI</span>
                                <span class="header-full">Virtual</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.Virtual))
                        </ChildContent>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="RowCol" Sortable="true" SortBy="@(GridSort<ColumnFeature>.ByAscending(f => f.RowColumn))" Class="rotated-header-col">
                        <HeaderTemplate>
                            <div class="rotated-header" title="RowColumn - Expandable row overlay with spacer row support">
                                <span class="header-abbrev">RC</span>
                                <span class="header-full">RowCol</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            @(RenderBoolCell(context.RowColumn))
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Feature Count by Column</h2>
            <p class="qg-section-description">
                Summary of how many features each column supports.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_featureCounts" Class="qg-grid">
                <PropertyColumn Property="@(c => c.ColumnName)" Title="Column" Sortable="true" />
                <PropertyColumn Property="@(c => c.TotalFeatures)" Title="Features Supported" Sortable="true" />
                <PropertyColumn Property="@(c => c.Percentage)" Title="Coverage" Format="P0" Sortable="true" />
                <TemplateColumn Title="Coverage Bar">
                    <div class="coverage-bar">
                        <div class="coverage-fill" style="width: @(context.Percentage * 100)%"></div>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Column Selection Guide</h2>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_recommendations" Class="qg-grid">
                <PropertyColumn Property="@(r => r.Scenario)" Title="Scenario" />
                <PropertyColumn Property="@(r => r.RecommendedColumn)" Title="Recommended Column" />
                <PropertyColumn Property="@(r => r.AlternativeColumn)" Title="Alternative" />
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Legend</h2>
        </div>
        <div class="legend-container">
            <div class="legend-item">
                <i class="bi bi-check-circle-fill" style="color: var(--qg-success, #22c55e);"></i>
                <span>Feature supported</span>
            </div>
            <div class="legend-item">
                <i class="bi bi-x-circle" style="color: var(--qg-neutral-400, #9ca3af);"></i>
                <span>Feature not supported</span>
            </div>
            <div class="legend-item legend-hint">
                <i class="bi bi-info-circle" style="color: var(--qg-primary, #3b82f6);"></i>
                <span>Hover over column headers for full descriptions</span>
            </div>
        </div>
    </section>
</div>

@code {
    private string _selectedCategory = "";
    private List<string> _categories = new();
    private IQueryable<ColumnOverview> _columnOverviews = default!;
    private List<ColumnFeature> _features = new();
    private IQueryable<FeatureCount> _featureCounts = default!;
    private IQueryable<ColumnRecommendation> _recommendations = default!;

    private IQueryable<ColumnFeature> FilteredFeatures => string.IsNullOrEmpty(_selectedCategory)
        ? _features.AsQueryable()
        : _features.Where(f => f.Category == _selectedCategory).AsQueryable();

    // Render helper for boolean icons - returns MarkupString for inline rendering
    private MarkupString RenderBoolCell(bool value)
    {
        var iconClass = value ? "bi bi-check-circle-fill icon-supported" : "bi bi-x-circle icon-not-supported";
        var tooltip = value ? "Supported" : "Not supported";
        return new MarkupString($"<div class=\"bool-icon-cell\" title=\"{tooltip}\"><i class=\"{iconClass}\"></i></div>");
    }

    protected override void OnInitialized()
    {
        InitializeColumnOverviews();
        InitializeFeatures();
        InitializeFeatureCounts();
        InitializeRecommendations();
        _categories = _features.Select(f => f.Category).Distinct().OrderBy(c => c).ToList();
    }

    private void InitializeColumnOverviews()
    {
        _columnOverviews = new List<ColumnOverview>
        {
            new("FormRowColumn", "Inline form editing with full row overlay", "QuickGridTest01.FormRow", "Complete form within grid row"),
            new("EditableColumn", "Inline cell editing with validation", "QuickGridTest01.CustomColumns", "Maximum editing flexibility"),
            new("MultiStateColumn", "Cell editing with state machine", "QuickGridTest01.MultiState", "Controlled async workflows"),
            new("FilterableColumn", "Column with built-in filtering UI", "QuickGridTest01.Filterable", "Per-column server-side filtering"),
            new("ConditionalStyleColumn", "Dynamic styling based on rules", "QuickGridTest01.ConditionalStyling", "Visual indicators by value"),
            new("FormattedValueColumn", "Value formatting with culture support", "QuickGridTest01.FormattedValue.Component", "Simple formatted display"),
            new("IconColumn", "Icon display with value mapping", "QuickGridTest01.CustomColumns", "Status icons and indicators"),
            new("OptimizedColumn", "Performance-optimized rendering", "QuickGridTest01.CustomColumns", "Maximum rendering performance"),
            new("VirtualColumn", "Optimized for virtual scrolling", "QuickGridTest01.CustomColumns", "Large datasets with virtualization"),
            new("RowColumn", "Expandable row overlay", "QuickGridTest01.RowColumn", "Row details with virtualization")
        }.AsQueryable();
    }

    private void InitializeFeatures()
    {
        _features = new List<ColumnFeature>
        {
            // Core Features
            new("Core", "Property Expression", false, true, true, true, true, true, true, true, true, false),
            new("Core", "Compiled Accessor", false, true, true, true, true, true, true, true, true, false),
            new("Core", "TypeTraits Integration", false, true, true, true, false, true, true, false, true, false),
            new("Core", "Auto Title Inference", true, true, true, true, true, false, true, true, true, true),
            new("Core", "Sortable", true, true, true, true, true, true, true, true, true, true),
            new("Core", "IDisposable", true, true, true, false, false, false, false, false, false, true),

            // Editing Features
            new("Editing", "Inline Editing", false, true, true, false, false, false, false, false, false, false),
            new("Editing", "Form Overlay Editing", true, false, false, false, false, false, false, false, false, true),
            new("Editing", "Edit State Management", true, true, true, false, false, false, false, false, false, true),
            new("Editing", "Multiple Edit Modes", false, true, false, false, false, false, false, false, false, false),
            new("Editing", "Read-Only Mode", false, false, true, false, false, false, false, false, false, false),
            new("Editing", "Debouncing", false, true, false, true, false, false, false, false, false, false),

            // Validation Features
            new("Validation", "Custom Validators", true, true, true, false, false, false, false, false, false, false),
            new("Validation", "DataAnnotations", true, true, false, false, false, false, false, false, false, false),
            new("Validation", "Validate on Change", true, true, true, false, false, false, false, false, false, false),
            new("Validation", "Validation Error Display", true, true, true, false, false, false, false, false, false, false),
            new("Validation", "Async Validation", true, true, true, false, false, false, false, false, false, false),

            // Formatting Features
            new("Formatting", "Format String", false, true, true, true, true, false, false, true, true, false),
            new("Formatting", "Custom Formatter", false, false, false, false, true, true, false, false, true, false),
            new("Formatting", "Culture Support", false, true, true, true, false, true, true, false, true, false),
            new("Formatting", "IFormattable Support", false, true, true, true, true, true, false, true, true, false),

            // Template Features
            new("Templates", "Display Template", true, true, false, false, false, false, false, false, false, true),
            new("Templates", "Form/Expanded Template", true, false, false, false, false, false, false, false, false, true),
            new("Templates", "Cell Template", false, false, false, false, true, false, false, false, false, false),
            new("Templates", "Cascading Value Context", true, false, false, false, false, false, false, false, false, true),

            // Event Callbacks
            new("Events", "OnBeforeEdit/Expand", true, false, true, false, false, false, false, false, false, true),
            new("Events", "OnValueChanged", false, true, true, false, false, false, false, false, false, false),
            new("Events", "OnSaveAsync", true, false, true, false, false, false, false, false, false, false),
            new("Events", "OnSaved/OnSaveResult", true, false, true, false, false, false, false, false, false, false),
            new("Events", "OnCancelled/OnCancelEdit", true, false, true, false, false, false, false, false, false, false),
            new("Events", "OnStateChanged", true, false, true, false, false, false, false, false, false, true),
            new("Events", "OnFilterChanged", false, false, false, true, false, false, false, false, false, false),
            new("Events", "OnExpanded/OnCollapsed", false, false, false, false, false, false, false, false, false, true),

            // Styling Features
            new("Styling", "Conditional CSS Classes", true, true, true, true, true, false, false, true, true, true),
            new("Styling", "Style Rules", false, false, false, false, true, false, false, false, false, false),
            new("Styling", "Icon Display", true, true, false, true, true, false, true, false, false, true),
            new("Styling", "Icon/Color Mapping", false, false, false, false, false, false, true, false, false, false),
            new("Styling", "Tooltip Support", false, false, false, false, true, false, true, true, false, false),
            new("Styling", "Dim Inactive Rows", true, false, false, false, false, false, false, false, false, true),
            new("Styling", "Base CSS Class", false, false, false, false, true, false, false, false, true, false),

            // Performance Features
            new("Performance", "Expression Compilation", false, true, true, true, true, true, true, true, true, false),
            new("Performance", "Memoization/Caching", false, false, false, false, false, false, true, true, false, false),
            new("Performance", "Minimal DOM", false, false, false, false, false, false, false, true, true, false),
            new("Performance", "SetKey for Reconciliation", false, true, true, false, false, false, true, false, true, false),

            // Virtualization Features
            new("Virtualization", "Optimized for Virtualization", false, false, false, false, false, false, false, true, true, true),
            new("Virtualization", "Spacer Row Support", false, false, false, false, false, false, false, false, false, true),
            new("Virtualization", "Configurable Row Height", false, false, false, false, false, false, false, false, false, true),
            new("Virtualization", "ExpandedRowSpan", false, false, false, false, false, false, false, false, false, true)
        };
    }

    private void InitializeFeatureCounts()
    {
        var totalFeatures = _features.Count;
        
        var counts = new List<FeatureCount>
        {
            new("FormRowColumn", _features.Count(f => f.FormRow), totalFeatures),
            new("EditableColumn", _features.Count(f => f.Editable), totalFeatures),
            new("MultiStateColumn", _features.Count(f => f.MultiState), totalFeatures),
            new("FilterableColumn", _features.Count(f => f.Filterable), totalFeatures),
            new("ConditionalStyleColumn", _features.Count(f => f.ConditionalStyle), totalFeatures),
            new("FormattedValueColumn", _features.Count(f => f.FormattedValue), totalFeatures),
            new("IconColumn", _features.Count(f => f.Icon), totalFeatures),
            new("OptimizedColumn", _features.Count(f => f.Optimized), totalFeatures),
            new("VirtualColumn", _features.Count(f => f.Virtual), totalFeatures),
            new("RowColumn", _features.Count(f => f.RowColumn), totalFeatures)
        };
        
        _featureCounts = counts.OrderByDescending(c => c.TotalFeatures).AsQueryable();
    }

    private void InitializeRecommendations()
    {
        _recommendations = new List<ColumnRecommendation>
        {
            new("Simple display with formatting", "FormattedValueColumn", "VirtualColumn"),
            new("Status indicators with icons", "IconColumn", "ConditionalStyleColumn"),
            new("Conditional styling based on values", "ConditionalStyleColumn", "IconColumn"),
            new("Quick inline cell editing", "EditableColumn", "MultiStateColumn"),
            new("Controlled async editing workflow", "MultiStateColumn", "EditableColumn"),
            new("Full form editing within row", "FormRowColumn", "RowColumn"),
            new("Column filtering", "FilterableColumn", "-"),
            new("Expandable row details", "RowColumn", "FormRowColumn"),
            new("Large datasets with virtualization", "VirtualColumn", "OptimizedColumn"),
            new("Maximum performance", "OptimizedColumn", "VirtualColumn")
        }.AsQueryable();
    }

    // Model classes
    public record ColumnOverview(string Name, string Purpose, string Namespace, string UseCase);
    
    public record ColumnRecommendation(string Scenario, string RecommendedColumn, string AlternativeColumn);

    public record FeatureCount(string ColumnName, int TotalFeatures, int TotalPossible)
    {
        public double Percentage => TotalPossible > 0 ? (double)TotalFeatures / TotalPossible : 0;
    }

    public class ColumnFeature
    {
        public string Category { get; set; } = "";
        public string FeatureName { get; set; } = "";
        public bool FormRow { get; set; }
        public bool Editable { get; set; }
        public bool MultiState { get; set; }
        public bool Filterable { get; set; }
        public bool ConditionalStyle { get; set; }
        public bool FormattedValue { get; set; }
        public bool Icon { get; set; }
        public bool Optimized { get; set; }
        public bool Virtual { get; set; }
        public bool RowColumn { get; set; }

        public ColumnFeature() { }

        public ColumnFeature(string category, string featureName, 
            bool formRow, bool editable, bool multiState, bool filterable,
            bool conditionalStyle, bool formattedValue, bool icon,
            bool optimized, bool virt, bool rowColumn)
        {
            Category = category;
            FeatureName = featureName;
            FormRow = formRow;
            Editable = editable;
            MultiState = multiState;
            Filterable = filterable;
            ConditionalStyle = conditionalStyle;
            FormattedValue = formattedValue;
            Icon = icon;
            Optimized = optimized;
            Virtual = virt;
            RowColumn = rowColumn;
        }
    }
}
