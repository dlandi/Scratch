@page "/row-column-demo"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.RowColumn
@using QuickGridTest01.RowColumn.Core
@using QuickGridTest01.RowColumn.Events
@using QuickGridTest01.RowColumn.Components

<PageTitle>RowColumn Demo</PageTitle>

<div class="qg-container">
    <header class="qg-page-header">
        <h1 class="qg-page-title">RowColumn Component</h1>
        <p class="qg-page-subtitle">
            A row-spanning QuickGrid column that renders expandable overlay content.
            Supports button, row-click, and custom triggers with configurable concurrent expand behavior.
        </p>
    </header>

    <div class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Architecture Overview</h2>
        </div>
        
        <div class="architecture-grid">
            <div class="arch-card">
                <h4>Expanded Template</h4>
                <p>Developer-defined RenderFragment using <code>RowCard</code> or custom components
                for flexible overlay content.</p>
            </div>
            
            <div class="arch-card">
                <h4>Trigger Modes</h4>
                <p>Button, RowClick, or Custom trigger modes give full control over how
                the expanded content is activated.</p>
            </div>
            
            <div class="arch-card">
                <h4>State Management</h4>
                <p>Tracks expanded rows with configurable concurrent behavior:
                Block, CollapseCurrent, or AllowMultiple.</p>
            </div>
            
            <div class="arch-card">
                <h4>Overlay Rendering</h4>
                <p>Content renders as a CSS card overlay on the active row with optional dimming of 
                inactive rows.</p>
            </div>
        </div>
    </div>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Button Trigger Mode</h2>
            <p class="qg-section-description">
                Click the View button to expand the row overlay. Default concurrent behavior blocks 
                expanding multiple rows.
            </p>
        </div>

        <div class="demo-controls">
            <label class="qg-label">Concurrent Behavior:</label>
            <select class="qg-select" @bind="_concurrentBehavior">
                <option value="@ConcurrentExpandBehavior.Block">Block</option>
                <option value="@ConcurrentExpandBehavior.CollapseCurrent">Collapse Current</option>
                <option value="@ConcurrentExpandBehavior.AllowMultiple">Allow Multiple</option>
            </select>
            
            <label class="inline-checkbox">
                <input type="checkbox" @bind="_dimInactiveRows" />
                <span>Dim inactive rows</span>
            </label>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_employees" Class="qg-grid qg-row-grid">
                <PropertyColumn Property="@(e => e.Id)" Title="ID" />
                <PropertyColumn Property="@(e => e.FirstName)" Title="First Name" />
                <PropertyColumn Property="@(e => e.LastName)" Title="Last Name" />
                <PropertyColumn Property="@(e => e.Email)" Title="Email" />
                <PropertyColumn Property="@(e => e.Department)" Title="Department" />
                
                <RowColumn TGridItem="Employee"
                           TriggerMode="RowTriggerMode.Button"
                           ConcurrentBehavior="@_concurrentBehavior"
                           DimInactiveRows="@_dimInactiveRows"
                           ExpandedRowSpan="3"
                           RowHeight="48"
                           ExpandButtonText="View"
                           ExpandButtonIcon="bi bi-eye"
                           OnExpanded="@OnRowExpanded"
                           OnCollapsed="@OnRowCollapsed"
                           OnStateChanged="@OnStateChangedHandler">
                    <ExpandedTemplate Context="ctx">
                        <RowCard Title="@($"Employee: {ctx.Item.FirstName} {ctx.Item.LastName}")" 
                                 ShowCloseButton="true" 
                                 OnClose="@ctx.CollapseAsync">
                            <ChildContent>
                                <p>This is a simple card overlay for row @ctx.Item.Id.</p>
                            </ChildContent>
                            <FooterContent>
                                <div class="row-card-actions">
                                    <button class="qg-btn qg-btn-primary" @onclick="@ctx.CollapseAsync">
                                        Close
                                    </button>
                                </div>
                            </FooterContent>
                        </RowCard>
                    </ExpandedTemplate>
                </RowColumn>
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Custom DisplayTemplate</h2>
            <p class="qg-section-description">
                Custom display template with multiple action buttons. Uses <code>TriggerMode.Custom</code> 
                for full control over the expand trigger.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_products" Class="qg-grid qg-row-grid">
                <PropertyColumn Property="@(p => p.Id)" Title="ID" />
                <PropertyColumn Property="@(p => p.Name)" Title="Product Name" />
                <PropertyColumn Property="@(p => p.Category)" Title="Category" />
                <PropertyColumn Property="@(p => p.Price)" Title="Price" Format="C2" />
                <PropertyColumn Property="@(p => p.Stock)" Title="Stock" />
                
                <RowColumn TGridItem="Product"
                           TriggerMode="RowTriggerMode.Custom"
                           ConcurrentBehavior="ConcurrentExpandBehavior.CollapseCurrent"
                           ExpandedRowSpan="3"
                           RowHeight="48"
                           OnStateChanged="@OnProductStateChanged">
                    <DisplayTemplate Context="ctx">
                        <div class="custom-actions">
                            <button class="qg-btn qg-btn-primary qg-btn-sm"
                                    @onclick="@(() => ctx.ExpandAsync())"
                                    disabled="@(!ctx.CanExpand)">
                                <i class="bi bi-eye"></i> View
                            </button>
                            <button class="qg-btn qg-btn-ghost qg-btn-sm"
                                    @onclick="() => DuplicateProduct(ctx.Item)">
                                <i class="bi bi-files"></i>
                            </button>
                            <button class="qg-btn qg-btn-ghost qg-btn-sm text-error"
                                    @onclick="() => DeleteProduct(ctx.Item)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </DisplayTemplate>
                    <ExpandedTemplate Context="ctx">
                        <RowCard Title="@($"Product: {ctx.Item.Name}")" ShowCloseButton="true" OnClose="@ctx.CollapseAsync">
                            <ChildContent>
                                <p>This is a simple card overlay for product @ctx.Item.Id.</p>
                            </ChildContent>
                            <FooterContent>
                                <div class="row-card-actions">
                                    <button class="qg-btn qg-btn-primary" @onclick="@ctx.CollapseAsync">
                                        Close
                                    </button>
                                </div>
                            </FooterContent>
                        </RowCard>
                    </ExpandedTemplate>
                </RowColumn>
            </QuickGrid>
        </div>
    </section>

    @if (_eventLog.Any())
    {
        <section class="qg-section">
            <div class="qg-section-header">
                <h2 class="qg-section-title">Event Log</h2>
                <button class="qg-btn qg-btn-ghost qg-btn-sm" @onclick="() => _eventLog.Clear()">
                    Clear Log
                </button>
            </div>
            <div class="event-log">
                @foreach (var entry in _eventLog.TakeLast(10).Reverse())
                {
                    <div class="log-entry">@entry</div>
                }
            </div>
        </section>
    }
</div>

@code {
    private IQueryable<Employee> _employees = default!;
    private IQueryable<Product> _products = default!;
    
    private ConcurrentExpandBehavior _concurrentBehavior = ConcurrentExpandBehavior.Block;
    private bool _dimInactiveRows = true;
    
    private List<string> _eventLog = new();

    protected override void OnInitialized()
    {
        _employees = new List<Employee>
        {
            new() { Id = 1, FirstName = "Alice", LastName = "Johnson", Email = "alice@example.com", Department = "Engineering", Salary = 95000, HireDate = new DateTime(2020, 3, 15) },
            new() { Id = 2, FirstName = "Bob", LastName = "Smith", Email = "bob@example.com", Department = "Marketing", Salary = 75000, HireDate = new DateTime(2019, 7, 22) },
            new() { Id = 3, FirstName = "Carol", LastName = "Williams", Email = "carol@example.com", Department = "Sales", Salary = 82000, HireDate = new DateTime(2021, 1, 10) },
            new() { Id = 4, FirstName = "David", LastName = "Brown", Email = "david@example.com", Department = "Engineering", Salary = 105000, HireDate = new DateTime(2018, 11, 5) },
            new() { Id = 5, FirstName = "Eva", LastName = "Davis", Email = "eva@example.com", Department = "HR", Salary = 72000, HireDate = new DateTime(2022, 4, 5) },
            new() { Id = 6, FirstName = "Frank", LastName = "Miller", Email = "frank@example.com", Department = "Engineering", Salary = 98000, HireDate = new DateTime(2020, 11, 30) },
            new() { Id = 7, FirstName = "Grace", LastName = "Wilson", Email = "grace@example.com", Department = "Marketing", Salary = 85000, HireDate = new DateTime(2021, 2, 14) },
            new() { Id = 8, FirstName = "Henry", LastName = "Moore", Email = "henry@example.com", Department = "Sales", Salary = 76000, HireDate = new DateTime(2022, 8, 1) },
            new() { Id = 9, FirstName = "Iris", LastName = "Taylor", Email = "iris@example.com", Department = "Engineering", Salary = 110000, HireDate = new DateTime(2017, 6, 12) },
            new() { Id = 10, FirstName = "Jack", LastName = "Anderson", Email = "jack@example.com", Department = "HR", Salary = 68000, HireDate = new DateTime(2023, 1, 8) },
        }.AsQueryable();

        _products = new List<Product>
        {
            new() { Id = 1, Name = "Widget Pro", Category = "Electronics", Price = 299.99m, Stock = 150, Description = "Professional-grade widget with advanced features." },
            new() { Id = 2, Name = "Gadget Max", Category = "Electronics", Price = 199.99m, Stock = 75, Description = "Maximum performance gadget for everyday use." },
            new() { Id = 3, Name = "Tool Set Basic", Category = "Hardware", Price = 49.99m, Stock = 200, Description = "Essential tool set for home repairs." },
            new() { Id = 4, Name = "Power Drill X", Category = "Hardware", Price = 149.99m, Stock = 85, Description = "High-powered drill for professional use." },
            new() { Id = 5, Name = "Smart Watch", Category = "Electronics", Price = 399.99m, Stock = 120, Description = "Feature-rich smartwatch with health tracking." },
            new() { Id = 6, Name = "Bluetooth Speaker", Category = "Electronics", Price = 79.99m, Stock = 200, Description = "Portable speaker with premium sound quality." },
            new() { Id = 7, Name = "LED Flashlight", Category = "Hardware", Price = 29.99m, Stock = 300, Description = "Ultra-bright LED flashlight with long battery life." },
            new() { Id = 8, Name = "Wireless Mouse", Category = "Electronics", Price = 49.99m, Stock = 175, Description = "Ergonomic wireless mouse with precision tracking." },
            new() { Id = 9, Name = "Screwdriver Set", Category = "Hardware", Price = 39.99m, Stock = 250, Description = "Complete screwdriver set with multiple heads." },
            new() { Id = 10, Name = "USB Hub", Category = "Electronics", Price = 34.99m, Stock = 140, Description = "7-port USB hub with fast charging support." },
        }.AsQueryable();
    }

    private void OnRowExpanded(RowExpandedEventArgs<Employee> args)
    {
        LogEvent($"Expanded: {args.Item.FirstName} {args.Item.LastName}");
    }

    private void OnRowCollapsed(RowCollapsedEventArgs<Employee> args)
    {
        LogEvent($"Collapsed: {args.Item.FirstName} {args.Item.LastName}");
    }

    private void OnStateChangedHandler(RowStateChangedEventArgs<Employee> args)
    {
        LogEvent($"Employee state: {args.OldState} → {args.NewState}");
    }

    private void OnProductStateChanged(RowStateChangedEventArgs<Product> args)
    {
        LogEvent($"Product state: {args.OldState} → {args.NewState}");
    }

    private void DuplicateProduct(Product product)
    {
        LogEvent($"Duplicate clicked: {product.Name}");
    }

    private void DeleteProduct(Product product)
    {
        LogEvent($"Delete clicked: {product.Name}");
    }

    private void LogEvent(string message)
    {
        _eventLog.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        StateHasChanged();
    }

    // Demo model classes
    public class Employee
    {
        public int Id { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Department { get; set; } = "";
        public decimal Salary { get; set; }
        public DateTime HireDate { get; set; }
    }

    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public int Stock { get; set; }
        public string Description { get; set; } = "";
    }
}
