@page "/composable-demo"
@using QuickGridTest01.ComposableColumns.Demos
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.ComposableColumns.Core
@using QuickGridTest01.ComposableColumns.Features.Core
@using QuickGridTest01.ComposableColumns.Features.Formatting
@using QuickGridTest01.ComposableColumns.Features.Styling
@using QuickGridTest01.ComposableColumns.Features.Editing
@using QuickGridTest01.ComposableColumns.Features.Filtering
@using QuickGridTest01.CustomColumns
@using QuickGridTest01.Filterable
@using System.Linq.Expressions
@using EditKind = QuickGridTest01.ComposableColumns.Features.Editing.EditorKind

<PageTitle>Composable Columns Demo</PageTitle>

<div>
    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Basic Composable Column</h2>
            <p class="qg-section-description">
                A simple column with auto-title inference and format string features.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_products" Class="qg-grid">
                <PropertyColumn Property="@(p => p.Id)" Title="ID" />
                <PropertyColumn Property="@(p => p.Name)" Title="Name" />


                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  Format="C2"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="DateTime"
                                  Property="@(p => p.LastUpdated)"
                                  Title="Last Updated"
                                  Format="yyyy-MM-dd"
                                  Sortable="true" />
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">With Styling Features</h2>
            <p class="qg-section-description">
                Composing IconFeature and ConditionalCssFeature for visual indicators.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_products" Class="qg-grid">
                <PropertyColumn Property="@(p => p.Name)" Title="Product" />

                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock Level"
                                  FeatureCollection="@_stockFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="ProductStatus"
                                  Property="@(p => p.Status)"
                                  Title="Status"
                                  FeatureCollection="@_statusFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  FeatureCollection="@_priceFeatures"
                                  Sortable="true" />
            </QuickGrid>
        </div>

        <div class="code-preview">
            <h4>Feature Composition Code:</h4>
            <pre><code>// Stock level with conditional CSS
var stockFeatures = new IColumnFeature&lt;Product&gt;[]
{
    new ConditionalCssFeature&lt;Product, int&gt;
    {
        BaseClass = "stock-cell",
        Rules = [
            new() { Condition = v =&gt; v == 0, CssClass = "stock-empty" },
            new() { Condition = v =&gt; v &lt; 10, CssClass = "stock-low" },
            new() { Condition = v =&gt; v &gt;= 10, CssClass = "stock-ok" }
        ]
    }
};

// Status with icon mapping
var statusFeatures = new IColumnFeature&lt;Product&gt;[]
{
    new IconFeature&lt;Product, ProductStatus&gt;
    {
        IconMapper = status =&gt; status switch
        {
            ProductStatus.Active =&gt; "bi bi-check-circle-fill",
            ProductStatus.Discontinued =&gt; "bi bi-x-circle-fill",
            ProductStatus.ComingSoon =&gt; "bi bi-clock-fill",
            _ =&gt; "bi bi-question-circle"
        }
    }
};</code></pre>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Filtering Features</h2>
            <p class="qg-section-description">
                <strong>Grid-integrated filtering:</strong> Add <code>FilterFeature</code> to any column and 
                <code>ComposableGrid</code> automatically renders a filter toolbar and applies filters to the data.
                Type-aware operators, debounced input, and coordinated "Clear All" functionality.
            </p>
        </div>

        <div class="qg-grid-container">
            <ComposableGrid @ref="_filterGrid" TGridItem="Product" Items="@_products" RowKey="p => p.Id" Class="qg-grid">
                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Id)"
                                  Title="ID" />
                <ComposableColumn TGridItem="Product" TValue="string"
                                  Property="@(p => p.Name)"
                                  Title="Name"
                                  Sortable="true"
                                  FeatureCollection="@_nameFilterFeatures" />
                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  Format="C2"
                                  Sortable="true"
                                  FeatureCollection="@_priceFilterFeatures" />
                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock"
                                  Sortable="true"
                                  FeatureCollection="@_stockFilterFeatures" />
                <ComposableColumn TGridItem="Product" TValue="DateTime"
                                  Property="@(p => p.LastUpdated)"
                                  Title="Updated"
                                  Format="yyyy-MM-dd"
                                  Sortable="true"
                                  FeatureCollection="@_dateFilterFeatures" />
                <ComposableColumn TGridItem="Product" TValue="bool"
                                  Property="@(p => p.InStock)"
                                  Title="In Stock"
                                  Sortable="true"
                                  FeatureCollection="@_inStockFilterFeatures" />
            </ComposableGrid>
        </div>

        <div class="code-preview">
            <h4>Feature Composition Code:</h4>
            <pre><code>// Simply add FilterFeature to columns - grid handles the rest!
// The grid auto-detects filter features and:
// 1. Renders a filter toolbar above the grid
// 2. Applies all active filters to the data
// 3. Shows "X of Y" count when filters are active
// 4. Provides "Clear All" button

// String filter - auto-detects: Contains, Equals, StartsWith, EndsWith
_nameFilterFeatures = [new FilterFeature&lt;Product, string&gt; { Placeholder = "Name..." }];

// Numeric filters - auto-detects: Equals, GreaterThan, LessThan
_priceFilterFeatures = [new FilterFeature&lt;Product, decimal&gt; { Placeholder = "Price..." }];
_stockFilterFeatures = [new FilterFeature&lt;Product, int&gt; { Placeholder = "Stock..." }];

// DateTime filter - auto-detects: Equals, After, Before
_dateFilterFeatures = [new FilterFeature&lt;Product, DateTime&gt; { Placeholder = "Date..." }];

// Boolean filter - renders as checkbox
_inStockFilterFeatures = [new FilterFeature&lt;Product, bool&gt;()];</code></pre>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Inline Editing Features</h2>
            <p class="qg-section-description">
                Cells are always in edit mode with seamless inputs. 
                <strong>Validation occurs when you leave a cell (on blur)</strong>, not while typing.
                Press Enter to commit, Escape to cancel.
            </p>
        </div>

        <div class="validation-rules-panel">
            <h4>Validation Rules (applied on blur)</h4>
            <div class="validation-rules-grid">
                <div class="rule-card">
                    <strong>Name</strong>
                    <ul>
                        <li>Required field</li>
                        <li>Min 2 characters</li>
                        <li>Max 50 characters</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Price</strong>
                    <ul>
                        <li>Range: $0.01 - $10,000</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Stock</strong>
                    <ul>
                        <li>Minimum: 0</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Status</strong>
                    <ul>
                        <li>No validation (select)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="edit-message" style="@(!string.IsNullOrEmpty(_lastEditMessage) ? "" : "display: none;")">
            <i class="bi bi-check-circle"></i> @_lastEditMessage
        </div>

        <div class="qg-grid-container">
            <ComposableGrid TGridItem="EditableProduct" Items="@_editableProducts" RowKey="p => p.Id" Class="qg-grid">
                <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                  Property="@(p => p.Id)"
                                  Title="ID" />

                <ComposableColumn TGridItem="EditableProduct" TValue="string"
                                  Property="@(p => p.Name)"
                                  Title="Name (Editable)"
                                  FeatureCollection="@_nameEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price (Editable)"
                                  FeatureCollection="@_priceEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock (Editable)"
                                  FeatureCollection="@_stockEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="ProductStatus"
                                  Property="@(p => p.Status)"
                                  Title="Status (Select)"
                                  FeatureCollection="@_statusEditFeatures"
                                  Sortable="true" />
            </ComposableGrid>
        </div>

        <div class="code-preview">
            <h4>Editing Features Code:</h4>
            <pre><code>// Name with text editing and validation
var nameEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, string&gt;
    {
        Editor = EditorKind.Text,
        Placeholder = "Enter name...",
        ItemKey = p =&gt; p.Id,
        ShowValidationErrors = true,
        Validators = [
            new RequiredStringValidator(), 
            new StringLengthValidator { MinLength = 2, MaxLength = 50 }
        ]
    }
};

// Price with currency editing
var priceEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, decimal&gt;
    {
        Editor = EditorKind.Currency,
        ItemKey = p =&gt; p.Id,
                Step = "0.01",
                Validators = [new RangeValidator&lt;decimal&gt; { Minimum = 0.01m, Maximum = 10000m }]
            }
        };</code></pre>
                </div>
            </section>

            <section class="qg-section">
                <div class="qg-section-header">
                    <h2 class="qg-section-title">New Editor Types: Auto &amp; RadioGroup</h2>
                    <p class="qg-section-description">
                        <strong>EditorKind.Auto</strong> automatically detects the appropriate editor from the property type.
                        <strong>EditorKind.RadioGroup</strong> renders enum values as radio buttons for quick selection.
                    </p>
                </div>

                <div class="qg-grid-container">
                    <ComposableGrid TGridItem="EditableProduct" Items="@_editableProducts" RowKey="p => p.Id" Class="qg-grid">
                        <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                          Property="@(p => p.Id)"
                                          Title="ID" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="string"
                                          Property="@(p => p.Name)"
                                          Title="Name (Auto)"
                                          FeatureCollection="@_autoNameFeatures" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="decimal"
                                          Property="@(p => p.Price)"
                                          Title="Price (Auto)"
                                          FeatureCollection="@_autoPriceFeatures" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="ProductStatus"
                                          Property="@(p => p.Status)"
                                          Title="Status (Radio)"
                                          FeatureCollection="@_radioStatusFeatures" />
                    </ComposableGrid>
                </div>

                <div class="code-preview">
                    <h4>Auto Detection &amp; RadioGroup Code:</h4>
                    <pre><code>// Auto detects Text editor from string property
        var autoNameFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
        {
            new InlineEditingFeature&lt;EditableProduct, string&gt;
            {
                Editor = EditorKind.Auto,  // Detects Text from string
                ItemKey = p =&gt; p.Id
            }
        };

        // Auto detects Number editor from decimal property
        var autoPriceFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
        {
            new InlineEditingFeature&lt;EditableProduct, decimal&gt;
            {
                Editor = EditorKind.Auto,  // Detects Number from decimal
                ItemKey = p =&gt; p.Id
            }
        };

        // RadioGroup for enum - renders all values as radio buttons
        var radioStatusFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
        {
            new InlineEditingFeature&lt;EditableProduct, ProductStatus&gt;
            {
                Editor = EditorKind.RadioGroup,  // Radio buttons instead of dropdown
                ItemKey = p =&gt; p.Id,
                OptionText = s =&gt; s switch  // Custom display text
                {
                    ProductStatus.Active =&gt; "? Active",
                    ProductStatus.Discontinued =&gt; "? Discontinued",
                    ProductStatus.ComingSoon =&gt; "? Coming Soon",
                    _ =&gt; s.ToString()
                }
            }
        };</code></pre>
                </div>
            </section>

            <section class="qg-section">
                <div class="qg-section-header">
                    <h2 class="qg-section-title">Edit Event Stream Demo</h2>
                    <p class="qg-section-description">
                        <strong>Grid-integrated event logging:</strong> Enable <code>ShowEvents="true"</code> on editing features 
                        to publish lifecycle events to an <code>IEditEventStream</code>. Use <code>EventPanelPlacement</code> 
                        to auto-render the <code>EditEventViewer</code> panel, or manually place it using the cascaded stream.
                    </p>
                </div>

                <div class="event-demo-controls">
                    <div class="placement-selector">
                        <label>Panel Placement:</label>
                        <select @bind="_selectedPlacement">
                            <option value="@EventPanelPlacement.None">None (Manual)</option>
                            <option value="@EventPanelPlacement.Top">Top</option>
                            <option value="@EventPanelPlacement.Right">Right</option>
                            <option value="@EventPanelPlacement.Bottom">Bottom</option>
                            <option value="@EventPanelPlacement.Left">Left</option>
                        </select>
                    </div>
                    <div class="event-counters">
                        <span class="counter commit"><i class="bi bi-check-circle"></i> @_commitCount commits</span>
                        <span class="counter cancel"><i class="bi bi-x-circle"></i> @_cancelCount cancels</span>
                        <span class="counter error"><i class="bi bi-exclamation-triangle"></i> @_validationErrorCount errors</span>
                        <button type="button" class="btn-reset-counters" @onclick="ResetEventCounters">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                    </div>
                </div>

                <div class="qg-grid-container">
                    <ComposableGrid @ref="_eventDemoGrid" TGridItem="EditableProduct" Items="@_editableProducts" 
                                    RowKey="p => p.Id" Class="qg-grid" 
                                    EventPanelPlacement="@_selectedPlacement">
                        <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                          Property="@(p => p.Id)"
                                          Title="ID" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="string"
                                          Property="@(p => p.Name)"
                                          Title="Name"
                                          FeatureCollection="@_eventDemoNameFeatures"
                                          Sortable="true" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="decimal"
                                          Property="@(p => p.Price)"
                                          Title="Price"
                                          FeatureCollection="@_eventDemoPriceFeatures"
                                          Sortable="true" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                          Property="@(p => p.Stock)"
                                          Title="Stock"
                                          FeatureCollection="@_eventDemoStockFeatures"
                                          Sortable="true" />

                        <ComposableColumn TGridItem="EditableProduct" TValue="ProductStatus"
                                          Property="@(p => p.Status)"
                                          Title="Status"
                                          FeatureCollection="@_eventDemoStatusFeatures"
                                          Sortable="true" />
                    </ComposableGrid>
                </div>

                <div class="code-preview">
                    <h4>Event Stream Integration:</h4>
                    <pre><code>// Enable events on editing features
var nameEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, string&gt;
    {
        Editor = EditorKind.Text,
        ItemKey = p =&gt; p.Id,
        ShowEvents = true,  // Publishes to cascaded IEditEventStream
        Validators = [new RequiredStringValidator()]
    }
};

// Option 1: Auto-render panel with EventPanelPlacement
&lt;ComposableGrid Items="@@items" EventPanelPlacement="EventPanelPlacement.Right"&gt;
    ...
&lt;/ComposableGrid&gt;

// Option 2: Manual panel placement
&lt;div class="layout-horizontal"&gt;
    &lt;ComposableGrid Items="@@items"&gt;...&lt;/ComposableGrid&gt;
    &lt;EditEventViewer /&gt;  @* Consumes cascaded IEditEventStream *@
&lt;/div&gt;</code></pre>
                </div>
            </section>

</div>
