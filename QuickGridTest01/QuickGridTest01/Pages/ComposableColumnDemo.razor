@page "/composable-demo"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGridTest01.ComposableColumns.Core
@using QuickGridTest01.ComposableColumns.Features.Core
@using QuickGridTest01.ComposableColumns.Features.Formatting
@using QuickGridTest01.ComposableColumns.Features.Styling
@using QuickGridTest01.ComposableColumns.Features.Editing
@using QuickGridTest01.ComposableColumns.Features.Filtering
@using QuickGridTest01.CustomColumns
@using QuickGridTest01.Filterable
@using System.Linq.Expressions
@using EditKind = QuickGridTest01.ComposableColumns.Features.Editing.EditorKind

<PageTitle>Composable Columns Demo</PageTitle>

<div class="qg-container">
    <header class="qg-page-header">
        <h1 class="qg-page-title">Composable Columns</h1>
        <p class="qg-page-subtitle">
            A modular column system where features can be composed together.
            Each feature is a building block that adds specific functionality.
        </p>
    </header>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Architecture Overview</h2>
        </div>

        <div class="architecture-grid">
            <div class="arch-card">
                <h4><i class="bi bi-puzzle"></i> Features</h4>
                <p>Modular units of functionality that can be added to any column.
                   Each feature implements <code>IColumnFeature&lt;T&gt;</code>.</p>
            </div>

            <div class="arch-card">
                <h4><i class="bi bi-layers"></i> Pipeline</h4>
                <p>Features are executed in priority order, forming a render pipeline.
                   Each feature can wrap or modify the output.</p>
            </div>

            <div class="arch-card">
                <h4><i class="bi bi-share"></i> Shared Context</h4>
                <p><code>FeatureContext</code> provides shared state between features.
                   Features can read/write state and register services.</p>
            </div>

            <div class="arch-card">
                <h4><i class="bi bi-building"></i> Builder Pattern</h4>
                <p>Fluent API for composing columns in code.
                   Chain features together with <code>WithFeature()</code>.</p>
            </div>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Basic Composable Column</h2>
            <p class="qg-section-description">
                A simple column with auto-title inference and format string features.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_products" Class="qg-grid">
                <PropertyColumn Property="@(p => p.Id)" Title="ID" />
                <PropertyColumn Property="@(p => p.Name)" Title="Name" />


                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  Format="C2"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="DateTime"
                                  Property="@(p => p.LastUpdated)"
                                  Title="Last Updated"
                                  Format="yyyy-MM-dd"
                                  Sortable="true" />
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">With Styling Features</h2>
            <p class="qg-section-description">
                Composing IconFeature and ConditionalCssFeature for visual indicators.
            </p>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_products" Class="qg-grid">
                <PropertyColumn Property="@(p => p.Name)" Title="Product" />

                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock Level"
                                  FeatureCollection="@_stockFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="ProductStatus"
                                  Property="@(p => p.Status)"
                                  Title="Status"
                                  FeatureCollection="@_statusFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  FeatureCollection="@_priceFeatures"
                                  Sortable="true" />
            </QuickGrid>
        </div>

        <div class="code-preview">
            <h4>Feature Composition Code:</h4>
            <pre><code>// Stock level with conditional CSS
var stockFeatures = new IColumnFeature&lt;Product&gt;[]
{
    new ConditionalCssFeature&lt;Product, int&gt;
    {
        BaseClass = "stock-cell",
        Rules = [
            new() { Condition = v =&gt; v == 0, CssClass = "stock-empty" },
            new() { Condition = v =&gt; v &lt; 10, CssClass = "stock-low" },
            new() { Condition = v =&gt; v &gt;= 10, CssClass = "stock-ok" }
        ]
    }
};

// Status with icon mapping
var statusFeatures = new IColumnFeature&lt;Product&gt;[]
{
    new IconFeature&lt;Product, ProductStatus&gt;
    {
        IconMapper = status =&gt; status switch
        {
            ProductStatus.Active =&gt; "bi bi-check-circle-fill",
            ProductStatus.Discontinued =&gt; "bi bi-x-circle-fill",
            ProductStatus.ComingSoon =&gt; "bi bi-clock-fill",
            _ =&gt; "bi bi-question-circle"
        },
        ColorMapper = status =&gt; status switch
        {
            ProductStatus.Active =&gt; "#22c55e",
            ProductStatus.Discontinued =&gt; "#ef4444",
            ProductStatus.ComingSoon =&gt; "#f59e0b",
            _ =&gt; "#6b7280"
        }
    }
};</code></pre>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Filtering Features</h2>
            <p class="qg-section-description">
                Filter data with type-aware operators. Filters are applied client-side with debouncing.
            </p>
        </div>

        <div class="filter-toolbar">
            <FilterInput TValue="string"
                         Label="Name"
                         Placeholder="Filter by name..."
                         DebounceMs="300"
                         OnFilterApplied="OnNameFilterApplied" />

            <FilterInput TValue="decimal"
                         Label="Price"
                         Placeholder="Filter by price..."
                         DebounceMs="300"
                         OnFilterApplied="OnPriceFilterApplied" />

            <FilterInput TValue="int"
                         Label="Stock"
                         Placeholder="Filter by stock..."
                         DebounceMs="300"
                         OnFilterApplied="OnStockFilterApplied" />

            @* Always render button container for stable structure *@
            <span style="@(_hasActiveFilters ? "" : "display: none;")">
                <button class="btn-clear-all-filters" @onclick="ClearAllFilters">
                    <i class="bi bi-x-circle"></i> Clear All Filters
                </button>
            </span>
        </div>

        @* Always render message container for stable structure *@
        <div class="filter-message" style="@(!string.IsNullOrEmpty(_filterMessage) ? "" : "display: none;")">
            <i class="bi bi-funnel-fill"></i> @_filterMessage
        </div>

        <div class="qg-grid-container">
            <ComposableGrid TGridItem="Product" Items="@FilteredProducts" RowKey="p => p.Id" Class="qg-grid">
                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Id)"
                                  Title="ID" />
                <ComposableColumn TGridItem="Product" TValue="string"
                                  Property="@(p => p.Name)"
                                  Title="Name"
                                  Sortable="true" />
                <ComposableColumn TGridItem="Product" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price"
                                  Format="C2"
                                  Sortable="true" />
                <ComposableColumn TGridItem="Product" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock"
                                  Sortable="true" />
                <ComposableColumn TGridItem="Product" TValue="ProductStatus"
                                  Property="@(p => p.Status)"
                                  Title="Status"
                                  Sortable="true" />
            </ComposableGrid>
        </div>

        <p class="filter-result-count">
            @{
                var filteredCount = FilteredProducts.Count();
                var totalCount = _products.Count();
            }
            Showing @filteredCount of @totalCount products
        </p>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Inline Editing Features</h2>
            <p class="qg-section-description">
                Cells are always in edit mode with seamless inputs. 
                <strong>Validation occurs when you leave a cell (on blur)</strong>, not while typing.
                Press Enter to commit, Escape to cancel.
            </p>
        </div>

        <div class="validation-rules-panel">
            <h4>Validation Rules (applied on blur)</h4>
            <div class="validation-rules-grid">
                <div class="rule-card">
                    <strong>Name</strong>
                    <ul>
                        <li>Required field</li>
                        <li>Min 2 characters</li>
                        <li>Max 50 characters</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Price</strong>
                    <ul>
                        <li>Range: $0.01 - $10,000</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Stock</strong>
                    <ul>
                        <li>Minimum: 0</li>
                    </ul>
                </div>
                <div class="rule-card">
                    <strong>Status</strong>
                    <ul>
                        <li>No validation (select)</li>
                    </ul>
                </div>
            </div>
        </div>

        @* Always render message container for stable structure *@
        <div class="edit-message" style="@(!string.IsNullOrEmpty(_lastEditMessage) ? "" : "display: none;")">
            <i class="bi bi-check-circle"></i> @_lastEditMessage
        </div>

        <div class="qg-grid-container">
            <ComposableGrid TGridItem="EditableProduct" Items="@_editableProducts" RowKey="p => p.Id" Class="qg-grid">
                <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                  Property="@(p => p.Id)"
                                  Title="ID" />

                <ComposableColumn TGridItem="EditableProduct" TValue="string"
                                  Property="@(p => p.Name)"
                                  Title="Name (Editable)"
                                  FeatureCollection="@_nameEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="decimal"
                                  Property="@(p => p.Price)"
                                  Title="Price (Editable)"
                                  FeatureCollection="@_priceEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="int"
                                  Property="@(p => p.Stock)"
                                  Title="Stock (Editable)"
                                  FeatureCollection="@_stockEditFeatures"
                                  Sortable="true" />

                <ComposableColumn TGridItem="EditableProduct" TValue="ProductStatus"
                                  Property="@(p => p.Status)"
                                  Title="Status (Select)"
                                  FeatureCollection="@_statusEditFeatures"
                                  Sortable="true" />
            </ComposableGrid>
        </div>

        <div class="code-preview">
            <h4>Editing Features Code:</h4>
            <pre><code>// Name with text editing
var nameEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, string&gt;
    {
        Editor = EditorKind.Text,
        Placeholder = "Enter name...",
        ItemKey = p =&gt; p.Id,
        OnValueChanged = EventCallback.Factory.Create&lt;ValueChangedEventArgs&lt;EditableProduct, string&gt;&gt;(
            this, args =&gt; HandleValueChanged($"Name changed to '{args.NewValue}'"))
    }
};

// Price with currency editing
var priceEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, decimal&gt;
    {
        Editor = EditorKind.Currency,
        ItemKey = p =&gt; p.Id,
        Step = "0.01",
        OnValueChanged = EventCallback.Factory.Create&lt;ValueChangedEventArgs&lt;EditableProduct, decimal&gt;&gt;(
            this, args =&gt; HandleValueChanged($"Price changed to {args.NewValue:C2}"))
    }
};

// Stock with number editing
var stockEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, int&gt;
    {
        Editor = EditorKind.Number,
        ItemKey = p =&gt; p.Id,
        Min = "0",
        OnValueChanged = EventCallback.Factory.Create&lt;ValueChangedEventArgs&lt;EditableProduct, int&gt;&gt;(
            this, args =&gt; HandleValueChanged($"Stock changed to {args.NewValue}"))
    }
};

// Status with select dropdown
var statusEditFeatures = new IColumnFeature&lt;EditableProduct&gt;[]
{
    new InlineEditingFeature&lt;EditableProduct, ProductStatus&gt
    {
        Editor = EditorKind.Select,
        ItemKey = p =&gt; p.Id,
        OnValueChanged = EventCallback.Factory.Create&lt;ValueChangedEventArgs&lt;EditableProduct, ProductStatus&gt;&gt;(
            this, args =&gt; HandleValueChanged($"Status changed to {args.NewValue}"))
    }
};</code></pre>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Feature Priority Order</h2>
        </div>

        <div class="qg-grid-container">
            <QuickGrid Items="@_featurePriorities" Class="qg-grid">
                <PropertyColumn Property="@(f => f.Category)" Title="Category" />
                <PropertyColumn Property="@(f => f.Priority)" Title="Priority" />
                <PropertyColumn Property="@(f => f.Description)" Title="Description" />
            </QuickGrid>
        </div>
    </section>

    <section class="qg-section">
        <div class="qg-section-header">
            <h2 class="qg-section-title">Available Features</h2>
        </div>

        <div class="feature-list">
            <div class="feature-category">
                <h4>Core Features</h4>
                <ul>
                    <li><code>AutoTitleFeature</code> - Infers column title from property name</li>
                    <li><code>CompiledAccessorFeature</code> - Compiles property expression for fast access</li>
                    <li><code>SortableFeature</code> - Enables column sorting</li>
                </ul>
            </div>

            <div class="feature-category">
                <h4>Formatting Features</h4>
                <ul>
                    <li><code>FormatStringFeature</code> - Applies format strings (C2, N0, yyyy-MM-dd)</li>
                    <li><code>CustomFormatterFeature</code> - Custom formatter function</li>
                </ul>
            </div>

            <div class="feature-category">
                <h4>Styling Features</h4>
                <ul>
                    <li><code>TooltipFeature</code> - Adds tooltips to cells</li>
                    <li><code>IconFeature</code> - Displays icons based on value</li>
                    <li><code>ConditionalCssFeature</code> - Applies CSS classes conditionally</li>
                </ul>
            </div>

            <div class="feature-category">
                <h4>Filtering Features</h4>
                <ul>
                    <li><code>FilterFeature</code> - Type-aware column filtering with operators</li>
                    <li><code>FilterCoordinator</code> - Manages multiple column filters</li>
                    <li>Built-in operators: Contains, Equals, Greater Than, Less Than, etc.</li>
                </ul>
            </div>

            <div class="feature-category">
                <h4>Editing Features</h4>
                <ul>
                    <li><code>InlineEditingFeature</code> - Always-visible seamless editors with validation</li>
                    <li>Supports <code>IValidator&lt;T&gt;</code> - Async validators with error messages</li>
                    <li>Built-in validators: <code>RequiredStringValidator</code>, <code>RangeValidator</code>, <code>EmailValidator</code>, etc.</li>
                </ul>
            </div>

            <div class="feature-category coming-soon">
                <h4>Coming Soon</h4>
                <ul>
                    <li><code>MemoizationFeature</code> - Caching for performance</li>
                    <li><code>AsyncSaveFeature</code> - Async save with loading states</li>
                </ul>
            </div>
        </div>
    </section>
</div>
