@page "/filter-test"
@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Filter Test - Minimal</PageTitle>

<h1>Minimal Filter Test</h1>
<p>This page tests filtering with plain QuickGrid - no ComposableGrid or features.</p>

<div class="filter-section">
    <label>Filter by Name:</label>
    <input type="text" @bind="_nameFilter" @bind:event="oninput" @bind:after="OnFilterChanged" />
    <span>Current filter: "@_nameFilter"</span>
</div>

<div class="grid-section" style="margin-top: 1rem;">
    <QuickGrid Items="@FilteredItems" TGridItem="TestItem">
        <PropertyColumn Property="@(x => x.Id)" Title="ID" />
        <PropertyColumn Property="@(x => x.Name)" Title="Name" />
        <PropertyColumn Property="@(x => x.Value)" Title="Value" />
    </QuickGrid>
</div>

<p>Showing @FilteredItems.Count() of @_items.Count() items</p>

@code {
    private string _nameFilter = "";
    private List<TestItem> _items = [];

    private IQueryable<TestItem> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_nameFilter))
                return _items.AsQueryable();
            
            return _items
                .Where(x => x.Name.Contains(_nameFilter, StringComparison.OrdinalIgnoreCase))
                .AsQueryable();
        }
    }

    protected override void OnInitialized()
    {
        _items =
        [
            new(1, "Apple", 1.50m),
            new(2, "Banana", 0.75m),
            new(3, "Cherry", 2.00m),
            new(4, "Date", 3.00m),
            new(5, "Elderberry", 4.50m),
            new(6, "Fig", 2.25m),
        ];
    }

    private void OnFilterChanged()
    {
        // Just trigger re-render - FilteredItems will be re-evaluated
        StateHasChanged();
    }

    public record TestItem(int Id, string Name, decimal Value);
}
