@using QuickGridTest01.ComposableColumns.Features.Grouping

<div class="qg-group-header">
    <span class="qg-group-key">@(_keyText)</span>
    <span class="qg-group-count">(@ItemCount)</span>
</div>

@code {
    [Parameter] public object? Key { get; set; }
    [Parameter] public int ItemCount { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public string NullGroupLabel { get; set; } = "(No Value)";

    private string _keyText => Key?.ToString() ?? NullGroupLabel;
}
